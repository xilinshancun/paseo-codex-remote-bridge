(version 1)
(allow default)
(deny network*)
(deny file-read* file-write*)
(allow file-read* (literal "/usr/libexec/sftp-server") (subpath "/usr/lib") (subpath "/System/Library"))
(allow file-read-metadata)
(allow file-read* file-write* (subpath (param "PROJECT")))
(import "dyld-support.sb")
(allow file-read* file-write* (literal "/dev/null"))
