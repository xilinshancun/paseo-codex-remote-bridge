diff --git a/packages/server/src/server/agent/providers/codex-mcp-routing.test.ts b/packages/server/src/server/agent/providers/codex-mcp-routing.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7ebcb13714e96b5c0f008a73324255f24523a07
--- /dev/null
+++ b/packages/server/src/server/agent/providers/codex-mcp-routing.test.ts
@@ -0,0 +1,90 @@
+import { describe, expect, test } from "vitest";
+import { CodexAppServerAgentSession } from "./codex-app-server-agent.js";
+import { CodexProviderOptionsSchema } from "./codex/options.js";
+import { createFakeCodexAppServer } from "./codex/test-utils/fake-app-server.js";
+import { createTestLogger } from "../../../test-utils/test-logger.js";
+import type { AgentSessionConfig } from "../agent-sdk-types.js";
+
+describe("Codex MCP environment routing", () => {
+  test.each([false, true])(
+    "preserves dynamic addresses and credentials on resumed=%s and later turns",
+    async (resumed) => {
+      const server = createFakeCodexAppServer();
+      const config: AgentSessionConfig = {
+        provider: "codex",
+        cwd: "/tmp/codex-mcp-routing",
+        model: "gpt-5.4",
+        modeId: "full-access",
+        providerOptions: { mcp_servers: { paseo: { environment_id: "mac" } } },
+        mcpServers: {
+          paseo: {
+            type: "http",
+            url: "http://127.0.0.1:48219/mcp/agents?callerAgentId=test-agent",
+            headers: { Authorization: "Bearer fixture-token" },
+          },
+          local: { type: "stdio", command: "example-mcp", args: ["--readonly"] },
+        },
+        toolPolicy: { preapproved: [{ kind: "mcp", server: "paseo", tool: "list_agents" }] },
+      };
+      const session = new CodexAppServerAgentSession(
+        config,
+        resumed ? { sessionId: "thread-1" } : null,
+        createTestLogger(),
+        async () => server.child,
+      );
+      try {
+        await session.startTurn("first");
+        server.completeTurn();
+        await new Promise<void>((resolve) => setImmediate(resolve));
+        await new Promise<void>((resolve) => setImmediate(resolve));
+        await session.startTurn("next");
+        const requests = server
+          .requests()
+          .filter((request) =>
+            [resumed ? "thread/resume" : "thread/start", "turn/start"].includes(request.method),
+          );
+        expect(requests.filter((request) => request.method === "turn/start")).toHaveLength(2);
+        expect(
+          requests.some(
+            (request) => request.method === (resumed ? "thread/resume" : "thread/start"),
+          ),
+        ).toBe(true);
+        for (const request of requests) {
+          expect(request.params).toMatchObject({
+            config: {
+              mcp_servers: {
+                paseo: {
+                  environment_id: "mac",
+                  url:
+                    config.mcpServers!.paseo!.type === "http" ? config.mcpServers!.paseo!.url : "",
+                  http_headers: { Authorization: "Bearer fixture-token" },
+                  tools: { list_agents: { approval_mode: "approve" } },
+                },
+                local: { command: "example-mcp", args: ["--readonly"] },
+              },
+            },
+          });
+          expect(request.params).not.toHaveProperty("config.mcp_servers.local.environment_id");
+        }
+        server.assertNoErrors();
+      } finally {
+        await session.close();
+      }
+    },
+  );
+
+  test("accepts a named environment and rejects blank routes and transport overrides", () => {
+    expect(
+      CodexProviderOptionsSchema.parse({ mcp_servers: { paseo: { environment_id: "mac" } } }),
+    ).toEqual({ mcp_servers: { paseo: { environment_id: "mac" } } });
+    expect(
+      CodexProviderOptionsSchema.safeParse({ mcp_servers: { paseo: { environment_id: " " } } })
+        .success,
+    ).toBe(false);
+    expect(
+      CodexProviderOptionsSchema.safeParse({
+        mcp_servers: { paseo: { environment_id: "mac", url: "http://stale" } },
+      }).success,
+    ).toBe(false);
+  });
+});
