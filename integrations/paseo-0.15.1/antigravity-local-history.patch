+import { readFile } from "node:fs/promises";
+import { homedir } from "node:os";
+import path from "node:path";
+import { z } from "zod";
+import type { ProviderTimelineItem } from "@getpaseo/plugin/server/provider";
+
+const call = z.object({ name: z.string(), args: z.record(z.string(), z.json()) });
+const step = z.object({
+  step_index: z.number().int().nonnegative(),
+  created_at: z.iso.datetime({ offset: true }),
+  type: z.string(),
+  status: z.string(),
+  content: z.string().optional(),
+  tool_calls: z.array(call).optional(),
+});
+
+interface HistoryRow {
+  timestamp: string;
+  item: ProviderTimelineItem;
+}
+
+export async function readLocalHistory(
+  conversationId: string,
+  env: Record<string, string>,
+): Promise<HistoryRow[] | null> {
+  if (!z.uuid().safeParse(conversationId).success) return null;
+  const directory = path.join(
+    env.HOME || env.USERPROFILE || homedir(),
+    ".gemini",
+    "antigravity-cli",
+    "brain",
+    conversationId,
+    ".system_generated",
+    "logs",
+  );
+  for (const filename of ["transcript_full.jsonl", "transcript.jsonl"]) {
+    let data: string;
+    try {
+      data = await readFile(path.join(directory, filename), "utf8");
+    } catch (error) {
+      if (error instanceof Error && "code" in error && error.code === "ENOENT") continue;
+      throw error;
+    }
+    const rows = parseTranscript(data, conversationId);
+    if (rows.length > 0) return rows;
+  }
+  return null;
+}
+
+function parseTranscript(data: string, conversationId: string): HistoryRow[] {
+  const rows: HistoryRow[] = [];
+  let calls: z.infer<typeof call>[] = [];
+  for (const line of data.split("\n")) {
+    if (!line.trim()) continue;
+    const entry = step.parse(JSON.parse(line));
+    const id = `${conversationId}:${entry.step_index}`;
+    const push = (item: ProviderTimelineItem) => rows.push({ timestamp: entry.created_at, item });
+    const text = entry.content ?? "";
+    switch (entry.type) {
+      case "USER_INPUT": {
+        calls = [];
+        const user = /^<USER_REQUEST>\r?\n([\s\S]*)\r?\n<\/USER_REQUEST>(?:\r?\n|$)/.exec(text);
+        push({ type: "user_message", id, messageId: id, text: user?.[1] ?? text });
+        break;
+      }
+      case "PLANNER_RESPONSE":
+        calls = entry.tool_calls ?? [];
+        if (text) push({ type: "assistant_message", id, messageId: id, text });
+        break;
+      case "GENERIC": {
+        // Native transcripts list tool results in the planner's call order.
+        const invocation = calls.shift();
+        const name = invocation?.name ?? "Antigravity tool";
+        const base = {
+          id,
+          callId: id,
+          name,
+          detail: {
+            type: "unknown" as const,
+            input: invocation?.args ?? {},
+            output: text,
+          },
+        };
+        if (entry.status === "ERROR" || entry.status === "FAILED") {
+          push({ ...base, type: "tool_call", status: "failed", error: text });
+        } else {
+          let status: "running" | "canceled" | "completed" = "completed";
+          if (entry.status === "RUNNING") status = "running";
+          if (entry.status === "CANCELED") status = "canceled";
+          push({ ...base, type: "tool_call", status, error: null });
+        }
+        break;
+      }
+      case "ERROR_MESSAGE":
+        push({ type: "error", id, message: text });
+        break;
+    }
+  }
+  return rows;
+}
