+test("a prompt waiting on a failed idle reload resumes the same thread normally and runs once", async () => {
+  const workdir = mkdtempSync(join(tmpdir(), "agent-manager-failed-idle-reload-"));
+  const storage = new AgentStorage(join(workdir, "agents"), logger);
+  const client = new ResumeTrackingTestAgentClient();
+  const resumeStarted = deferred<void>();
+  const allowFailure = deferred<void>();
+  const resume = vi.spyOn(client, "resumeSession").mockImplementationOnce(async () => {
+    resumeStarted.resolve();
+    await allowFailure.promise;
+    throw new Error("target account could not resume the thread");
+  });
+  const openings: unknown[] = [];
+  const manager = new AgentManager({
+    clients: { codex: client },
+    registry: storage,
+    logger,
+    pluginLifecycle: {
+      emit: () => {},
+      before: async (name, request) => {
+        if (name === "agent.open.before") openings.push(request);
+        return request;
+      },
+    },
+  });
+  const created = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+    workspaceId: undefined,
+  });
+  try {
+    const failure = expect(
+      manager.reloadAgentSessionIfIdle(created.id, "manual-switch"),
+    ).rejects.toThrow("target account");
+    await resumeStarted.promise;
+    const prompt = startAgentRun(manager, created.id, "continue my task", logger, {
+      runOptions: { clientMessageId: "user-prompt" },
+    });
+    allowFailure.resolve();
+    await failure;
+    expect((await prompt).disposition).toBe("turn_started");
+    await client.waitForRetryStart();
+    expect((await manager.waitForAgentEvent(created.id)).status).toBe("idle");
+    expect(resume.mock.calls.map(([handle]) => handle.sessionId)).toEqual([
+      created.persistence?.sessionId,
+      created.persistence?.sessionId,
+    ]);
+    expect(openings).toEqual([
+      expect.objectContaining({ reason: "create" }),
+      expect.objectContaining({ reason: "refresh", reloadRequestId: "manual-switch" }),
+      expect.objectContaining({ reason: "resume", purpose: "interactive" }),
+    ]);
+    expect(openings[2]).not.toHaveProperty("reloadRequestId");
+    expect(
+      manager.getTimeline(created.id).filter((item) => item.type === "user_message"),
+    ).toMatchObject([{ text: "continue my task", clientMessageId: "user-prompt" }]);
+  } finally {
+    allowFailure.resolve();
+    await manager.closeAgent(created.id);
+    await storage.flush();
+    rmSync(workdir, { recursive: true, force: true });
+  }
+});
