diff --git a/packages/app/src/plugins/model-account-menu.tsx b/packages/app/src/plugins/model-account-menu.tsx
new file mode 100644
index 000000000..4b860d089
--- /dev/null
+++ b/packages/app/src/plugins/model-account-menu.tsx
@@ -0,0 +1,244 @@
+import { useCallback, useMemo, useRef, useState } from "react";
+import { ScrollView, Text } from "react-native";
+import { useTranslation } from "react-i18next";
+import { ChevronDown } from "lucide-react-native";
+import { StyleSheet } from "react-native-unistyles";
+import type {
+  PluginModelAccount,
+  PluginModelAccountSource,
+  PluginModelAccountState,
+} from "@getpaseo/plugin/client";
+import type { ModelBrowserState } from "@/components/model-browser";
+import type { SheetHeader } from "@/components/adaptive-modal-sheet";
+import { PressHighlight } from "@/components/ui/press-highlight";
+import { ComboboxItem } from "@/components/ui/combobox";
+import { useFetchQueries } from "@/data/query";
+import { useInstalledPlugins } from "./registry";
+
+export function useModelAccountMenu(
+  serverId: string | null,
+  agentId: string | undefined,
+  visible: boolean,
+  {
+    view,
+    selectedProvider,
+    providers,
+  }: Pick<ModelBrowserState, "view" | "selectedProvider" | "providers">,
+) {
+  const { t } = useTranslation();
+  const plugins = useInstalledPlugins();
+  const onCurrentProvider = view.kind === "all" || view.providerId === selectedProvider;
+  const sources = useMemo(
+    () =>
+      visible && onCurrentProvider && agentId
+        ? plugins
+            .filter((plugin) => plugin.serverId === serverId)
+            .flatMap((plugin) => plugin.modelAccountSources ?? [])
+        : [],
+    [plugins, serverId, agentId, visible, onCurrentProvider],
+  );
+  const queries = useFetchQueries<PluginModelAccountState | null>(
+    sources.map(({ key, source }) => ({
+      queryKey: ["model-account", serverId, agentId, key],
+      queryFn: () => source.read(agentId!),
+      dataShape: "value",
+      staleTimeMs: 0,
+      gcTime: 0,
+      retry: false,
+      refetchInterval: (query) => (query.state.data?.pending ? 1200 : 5000),
+    })),
+  );
+  const index = queries.findIndex((query) => query.data != null);
+  const query = queries[index];
+  const state = query?.data;
+  const registration = sources[index];
+  const owner = registration && agentId ? JSON.stringify([registration.key, agentId]) : null;
+  const [page, setPage] = useState<string | null>(null);
+  const reset = useCallback(() => setPage(null), []);
+  const openAccounts = useCallback(() => setPage(owner), [owner]);
+
+  if (!state || !registration || !owner || !agentId) {
+    const unresolved = queries.some((entry) => entry.isError || entry.isPending);
+    const origin =
+      providers.find((entry) => entry.id === selectedProvider)?.label ?? selectedProvider;
+    const header = (base: SheetHeader): SheetHeader =>
+      unresolved
+        ? {
+            ...base,
+            title: t("modelSelector.accountAndOrigin", {
+              account: t("modelSelector.accountUnconfirmed"),
+              origin,
+            }),
+          }
+        : base;
+    return { header, body: null, reset };
+  }
+  const current = query.isError ? null : state.current;
+  const title =
+    current?.id === state.origin.id
+      ? t("modelSelector.currentAccount", { account: current.label })
+      : t("modelSelector.accountAndOrigin", {
+          account: current?.label ?? t("modelSelector.accountUnconfirmed"),
+          origin: state.origin.label,
+        });
+  const choosing = page === owner;
+  const header = (base: SheetHeader): SheetHeader =>
+    choosing
+      ? { title: t("modelSelector.switchAccount"), back: { onPress: reset } }
+      : {
+          ...base,
+          title,
+          titleControl: (
+            <PressHighlight
+              accessibilityRole="button"
+              accessibilityLabel={t("modelSelector.chooseAccount", { title })}
+              testID="model-account-trigger"
+              onPress={openAccounts}
+              style={styles.trigger}
+            >
+              <Text style={styles.title} numberOfLines={2}>
+                {title}
+              </Text>
+              <ChevronDown size={14} color={styles.icon.color} />
+            </PressHighlight>
+          ),
+        };
+  const body = choosing ? (
+    <AccountOptions
+      key={owner}
+      agentId={agentId}
+      source={registration.source}
+      state={state}
+      readError={query.error?.message}
+      refresh={query.refetch}
+    />
+  ) : null;
+  return { header, body, reset };
+}
+
+function AccountOptions({
+  agentId,
+  source,
+  state,
+  readError,
+  refresh,
+}: {
+  agentId: string;
+  source: PluginModelAccountSource;
+  state: PluginModelAccountState;
+  readError?: string;
+  refresh: () => Promise<unknown>;
+}) {
+  const { t } = useTranslation();
+  const [working, setWorking] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const locked = useRef(false);
+  const busy = working || state.canSwitch === false || Boolean(readError);
+  const change = useCallback(
+    async (target: string | null) => {
+      if (locked.current || busy) return;
+      locked.current = true;
+      setWorking(true);
+      setError(null);
+      try {
+        if (target === null) await source.cancel(agentId);
+        else await source.select(agentId, target);
+      } catch (cause) {
+        setError(cause instanceof Error ? cause.message : String(cause));
+      } finally {
+        try {
+          await refresh();
+        } finally {
+          locked.current = false;
+          setWorking(false);
+        }
+      }
+    },
+    [agentId, source, refresh, busy],
+  );
+  const cancel = useCallback(() => void change(null), [change]);
+  const pending = state.pending;
+  const errorText = error ?? readError ?? state.error;
+  return (
+    <ScrollView keyboardShouldPersistTaps="handled" testID="model-account-options">
+      {pending ? (
+        <Text accessibilityLiveRegion="polite" style={styles.notice}>
+          {t(
+            pending.phase === "queued"
+              ? "modelSelector.accountQueued"
+              : "modelSelector.accountSwitching",
+            {
+              account:
+                state.accounts.find((a) => a.id === pending.accountId)?.label ?? pending.accountId,
+            },
+          )}
+        </Text>
+      ) : null}
+      {errorText ? (
+        <Text accessibilityRole="alert" style={styles.error}>
+          {errorText}
+        </Text>
+      ) : null}
+      {state.accounts.map((account) => (
+        <AccountOption
+          key={account.id}
+          account={account}
+          change={change}
+          selected={!readError && account.id === state.current?.id}
+          disabled={busy || pending?.phase === "switching" || account.id === pending?.accountId}
+        />
+      ))}
+      {pending?.phase === "queued" ? (
+        <ComboboxItem
+          label={t("modelSelector.cancelAccountSwitch")}
+          testID="model-account-cancel"
+          disabled={busy}
+          onPress={cancel}
+        />
+      ) : null}
+    </ScrollView>
+  );
+}
+
+function AccountOption({
+  account,
+  selected,
+  disabled,
+  change,
+}: {
+  account: PluginModelAccount;
+  selected: boolean;
+  disabled: boolean;
+  change: (id: string) => Promise<void>;
+}) {
+  const press = useCallback(() => void change(account.id), [change, account.id]);
+  return (
+    <ComboboxItem
+      testID={`model-account-option-${account.id}`}
+      label={account.label}
+      selected={selected}
+      disabled={selected || disabled}
+      onPress={press}
+    />
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  trigger: {
+    flex: 1,
+    minWidth: 0,
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[1],
+    minHeight: 32,
+  },
+  title: {
+    flexShrink: 1,
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.semibold,
+  },
+  icon: { color: theme.colors.foregroundMuted },
+  notice: { padding: theme.spacing[3], color: theme.colors.foregroundMuted },
+  error: { padding: theme.spacing[3], color: theme.colors.statusDanger },
+}));
