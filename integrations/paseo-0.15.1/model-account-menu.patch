+test.each(["open", "reload"] as const)(
+  "cold idle reload and open resume once when %s starts first",
+  async (first) => {
+    const workdir = mkdtempSync(join(tmpdir(), "agent-manager-cold-idle-reload-"));
+    const storage = new AgentStorage(join(workdir, "agents"), logger);
+    const client = new TestAgentClient();
+    const resumeStarted = deferred<void>();
+    const allowResume = deferred<void>();
+    const originalResume = client.resumeSession.bind(client);
+    const resume = vi.spyOn(client, "resumeSession").mockImplementation(async (...args) => {
+      resumeStarted.resolve();
+      await allowResume.promise;
+      return originalResume(...args);
+    });
+    const manager = new AgentManager({ clients: { codex: client }, registry: storage, logger });
+    const created = await manager.createAgent({ provider: "codex", cwd: workdir }, undefined, {
+      workspaceId: undefined,
+    });
+    try {
+      await manager.closeAgent(created.id);
+      const open = () =>
+        ensureAgentLoaded(created.id, { agentManager: manager, agentStorage: storage, logger });
+      const reload = () => manager.reloadAgentSessionIfIdle(created.id, "switch");
+      const firstResult = first === "open" ? open() : reload();
+      await resumeStarted.promise;
+      const secondResult = first === "open" ? reload() : open();
+      allowResume.resolve();
+      const [winner, second] = await Promise.all([firstResult, secondResult]);
+      expect(winner?.id).toBe(created.id);
+      if (first === "open") expect(second).toBeNull();
+      else expect(second?.session).toBe(winner?.session);
+      expect(resume).toHaveBeenCalledTimes(1);
+      expect(resume.mock.calls[0]?.[0].sessionId).toBe(created.persistence?.sessionId);
+    } finally {
+      allowResume.resolve();
+      await manager.closeAgent(created.id);
+      await storage.flush();
+      rmSync(workdir, { recursive: true, force: true });
+    }
+  },
+);
