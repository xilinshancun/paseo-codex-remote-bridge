+        .mockRejectedValue(new Error("target could not resume the thread")),
+    },
+  });
+  const source = {};
+  const otherSocket = {};
+  session.updateClientCapabilities({ owned_subscriptions: true }, source);
+  session.updateClientCapabilities({ owned_subscriptions: true }, otherSocket);
+  const request = {
+    type: "agent.session.reload_if_idle.request",
+    agentId: "agent-1",
+    requestId: "switch-failed",
+  } as const;
+  await session.handleMessage(request, source);
+  expect(targetedMessages.filter(({ message }) => message.type === "rpc_error")).toEqual([
+    {
+      source,
+      message: {
+        type: "rpc_error",
+        payload: {
+          requestId: request.requestId,
+          requestType: request.type,
+          code: "handler_error",
+          error: "Request failed: target could not resume the thread",
+        },
+      },
+    },
+  ]);
+  expect(targetedMessages.some((item) => item.source === otherSocket)).toBe(false);
