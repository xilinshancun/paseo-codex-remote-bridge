+  // On POSIX, closing fd 0 while the child stays alive reproduces the SSH teardown race.
+  test.skipIf(process.platform === "win32")(
+    "isolates a broken child stdin during idle cleanup",
+    async () => {
+      const child = spawn(process.execPath, [
+        "-e",
+        'require("node:fs").closeSync(0); process.stdout.write("ready\\n"); setInterval(() => {}, 60000);',
+      ]);
+      const client = new CodexAppServerClient(child, createTestLogger());
+      const terminated = vi.fn();
