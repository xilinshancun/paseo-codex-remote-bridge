+      try {
+        const exited = once(child, "exit");
+        await once(child.stdout, "data");
+        await expect(client.request("thread/loaded/list", {}, 1000)).rejects.toThrow(
+          /EPIPE|stdin is not writable/,
+        );
+        expect(client.hasPendingRequests()).toBe(false);
+        await expect(client.request("thread/read", {})).rejects.toThrow("client is closed");
+        await exited;
+        expect(terminated).toHaveBeenCalledTimes(1);
+      } finally {
+        await client.dispose();
+      }
+    },
+  );
+
+  test("rejects outstanding requests once if stdin fails before the exit event", async () => {
+    const child = createCodexAppServerChildProcess();
+    const client = new CodexAppServerClient(child, createTestLogger());
+    const terminated = vi.fn();
+    client.setUnexpectedTerminationHandler(terminated);
+    const history = client.request("thread/read", {});
+    const loaded = client.request("thread/loaded/list", {});
+    const error = new Error("write EPIPE");
+    child.stdin.emit("error", error);
+    child.emit("exit", 255, null);
+    child.stdin.emit("error", error);
+    await expect(history).rejects.toBe(error);
+    await expect(loaded).rejects.toBe(error);
+    expect(terminated).toHaveBeenCalledExactlyOnceWith(error);
+    expect(client.hasPendingRequests()).toBe(false);
+  });
+
