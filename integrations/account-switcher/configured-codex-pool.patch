@@ -0,0 +1,38 @@
+import { readdir, rm } from "node:fs/promises";
+import { join } from "node:path";
+import { poolPath, readState, ReopenRequestSchema, RecoverySchema } from "./state";
+import type { PoolCoordinator, PoolPorts } from "./coordinator";
+
+/** Failed session startup has no guaranteed turn event. Keep its intent until recovery owns it. */
+export async function drainReopenRequests(
+  root: string,
+  coordinator: PoolCoordinator,
+  inspect: PoolPorts["inspect"],
+): Promise<void> {
+  const directory = join(root, "codex-pool", "reopen-requests");
+  const files = await readdir(directory).catch(() => []);
+  await Promise.allSettled(
+    files
+      .filter((file) => file.endsWith(".json"))
+      .map(async (file) => {
+        const path = join(directory, file);
+        const request = await readState(path, ReopenRequestSchema);
+        if (!request) return;
+        const agent = await inspect(request.agentId);
+        if (!agent || agent.archived || (agent.threadId && agent.threadId !== request.threadId)) {
+          await rm(path, { force: true });
+          return;
+        }
+        await coordinator.failed(
+          request.agentId,
+          "reopen-" + request.token,
+          "codex-pool.account-unavailable",
+        );
+        const recovery = await readState(
+          poolPath(root, "recoveries", request.agentId),
+          RecoverySchema,
+        );
+        if (recovery?.threadId === request.threadId) await rm(path, { force: true });
+      }),
+  );
+}
