+    async (candidate, model) => {
+      calls++;
+      active++;
+      maximum = Math.max(maximum, active);
+      await new Promise<void>((resolve) => releases.push(resolve));
+      active--;
+      return f.ports.probe(candidate, model);
+    },
+    () => now,
+  );
+  const reads = [...f.accounts, f.accounts[0]].map((candidate) =>
+    reader.read(candidate, "exact-model"),
+  );
+  expect(calls).toBe(2);
+  releases.shift()!();
+  await reads[0];
+  expect(calls).toBe(3);
+  for (const release of releases.splice(0)) release();
+  await Promise.all(reads);
+  expect(maximum).toBe(2);
