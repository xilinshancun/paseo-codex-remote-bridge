@@ -0,0 +1,224 @@
+import { createHash } from "node:crypto";
+import type { PoolAccount } from "./config";
+import { CodexRpc, object } from "./rpc";
+
+export interface PoolQuota {
+  id: string;
+  identity: string | null;
+  status: "available" | "exhausted" | "ineligible" | "unknown";
+  remaining: number;
+  resetAt: number | null;
+  checkedAt: number;
+}
+const paidPlans = new Set([
+  "plus",
+  "pro",
+  "prolite",
+  "promax",
+  "team",
+  "business",
+  "enterprise",
+  "edu",
+  "education",
+]);
+
+function limitWindows(limits: Record<string, unknown>[], now: number) {
+  const windows: { used: number; reset: number | null }[] = [];
+  for (const limit of limits) {
+    for (const key of ["primary", "secondary", "individualLimit"]) {
+      if (limit[key] == null) continue;
+      const window = object(limit[key]);
+      if (
+        typeof window.usedPercent !== "number" ||
+        !Number.isFinite(window.usedPercent) ||
+        window.usedPercent < 0 ||
+        window.usedPercent > 100
+      )
+        return null;
+      const reset =
+        typeof window.resetsAt === "number" && window.resetsAt * 1000 > now
+          ? window.resetsAt * 1000
+          : null;
+      windows.push({ used: window.usedPercent, reset });
+    }
+  }
+  return windows.length ? windows : null;
+}
+
+export function parsePoolQuota(
+  id: string,
+  accountResult: unknown,
+  rateResult: unknown,
+  modelsResult: unknown,
+  model: string,
+  now: number,
+): PoolQuota {
+  const result: PoolQuota = {
+    id,
+    identity: null,
+    status: "unknown",
+    remaining: 0,
+    resetAt: null,
+    checkedAt: now,
+  };
+  const account = object(object(accountResult).account),
+    rate = object(rateResult);
+  const rawIdentity =
+    rate.accountId ?? object(object(accountResult).workspaceRouting).chatgptAccountId;
+  if (typeof rawIdentity !== "string" || !rawIdentity) return result;
+  result.identity = createHash("sha256").update(rawIdentity).digest("hex");
+  if (
+    account.type !== "chatgpt" ||
+    typeof account.planType !== "string" ||
+    !paidPlans.has(account.planType.toLowerCase())
+  )
+    return { ...result, status: "ineligible" };
+  const models = object(modelsResult).data;
+  if (
+    !Array.isArray(models) ||
+    !models.some((value) => object(value).model === model || object(value).id === model)
+  )
+    return { ...result, status: "ineligible" };
+  const byId = object(rate.rateLimitsByLimitId);
+  // Conservatively check all returned buckets. A new model-specific bucket cannot silently bypass selection.
+  const limits = Object.keys(byId).length
+    ? Object.values(byId).map(object)
+    : [object(rate.rateLimits)];
+  const windows = limitWindows(limits, now);
+  if (!windows) return result;
+  const blocked =
+    rate.ordinaryUsageAllowed === false ||
+    limits.some(
+      (limit) =>
+        limit.spendControlReached === true ||
+        (limit.rateLimitReachedType != null && limit.rateLimitReachedType !== "none"),
+    );
+  if (
+    limits.some(
+      (limit) => typeof limit.planType === "string" && !paidPlans.has(limit.planType.toLowerCase()),
+    )
+  )
+    return { ...result, status: "ineligible" };
+  const full = windows.filter((window) => window.used >= 100);
+  const resetAt =
+    full.length && full.every((window) => window.reset !== null)
+      ? Math.max(...full.map((window) => window.reset!))
+      : null;
+  return {
+    ...result,
+    status: blocked || full.length ? "exhausted" : "available",
+    remaining: Math.min(...windows.map((window) => 100 - window.used)),
+    resetAt,
+  };
+}
+
+export async function probePoolAccount(account: PoolAccount, model: string): Promise<PoolQuota> {
+  const rpc = new CodexRpc(account);
+  try {
+    await rpc.initialize();
+    const identity = await rpc.request("account/read", {});
+    const rate = await rpc.request("account/rateLimits/read", {});
+    const models: unknown[] = [];
+    let cursor: string | undefined;
+    const seen = new Set<string>();
+    do {
+      const page = object(
+        await rpc.request("model/list", { includeHidden: true, ...(cursor ? { cursor } : {}) }),
+      );
+      if (!Array.isArray(page.data)) throw new Error("Invalid model catalog");
+      models.push(...page.data);
+      cursor = typeof page.nextCursor === "string" ? page.nextCursor : undefined;
+      if (cursor && seen.has(cursor)) throw new Error("Invalid model pagination");
+      if (cursor) seen.add(cursor);
+    } while (cursor && seen.size < 20);
+    if (cursor) throw new Error("Model pagination limit");
+    return parsePoolQuota(account.id, identity, rate, { data: models }, model, Date.now());
+  } catch {
+    return {
+      id: account.id,
+      identity: null,
+      status: "unknown",
+      remaining: 0,
+      resetAt: null,
+      checkedAt: Date.now(),
+    };
+  } finally {
+    await rpc.close();
+  }
+}
+
+export function selectPoolAccount(
+  accounts: readonly PoolAccount[],
+  quotas: readonly PoolQuota[],
+  excluded: ReadonlySet<string>,
+  now: number,
+): PoolAccount | null {
+  const identities = new Set<string>();
+  const eligible = quotas.filter(
+    (quota) =>
+      quota.status === "available" &&
+      quota.identity &&
+      now - quota.checkedAt <= 60_000 &&
+      now >= quota.checkedAt &&
+      !excluded.has(quota.id) &&
+      !excluded.has(quota.identity),
+  );
+  eligible.sort((a, b) => b.remaining - a.remaining || a.id.localeCompare(b.id));
+  for (const quota of eligible) {
+    if (identities.has(quota.identity!)) continue;
+    identities.add(quota.identity!);
+    const account = accounts.find((candidate) => candidate.id === quota.id);
+    if (account) return account;
+  }
+  return null;
+}
+
+export function isQuotaFailure(message: string): boolean {
+  return /usage[_ ]limit(?:[_ ]exceeded|[_ ]reached)?|you(?:'|’)ve hit your usage limit|quota[_ ]exceeded|insufficient_quota/i.test(
+    message.replace(/([a-z])([A-Z])/g, "$1_$2"),
+  );
+}
+
+/** One bounded probe pool for all failing chats, including simultaneous heartbeat failures. */
+export class PoolQuotaReader {
+  private active = 0;
+  private readonly queue: (() => void)[] = [];
+  private readonly flights = new Map<string, Promise<PoolQuota>>();
+  private readonly cache = new Map<string, PoolQuota>();
+  constructor(
+    private readonly probe: typeof probePoolAccount = probePoolAccount,
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  read(account: PoolAccount, model: string): Promise<PoolQuota> {
+    const key = createHash("sha256")
+      .update(JSON.stringify([account, model]))
+      .digest("hex");
+    const cached = this.cache.get(key);
+    if (cached && this.now() - cached.checkedAt >= 0 && this.now() - cached.checkedAt < 5_000)
+      return Promise.resolve(cached);
+    const existing = this.flights.get(key);
+    if (existing) return existing;
+    const flight = this.run(account, model)
+      .then((value) => {
+        this.cache.set(key, value);
+        if (this.cache.size > 128) this.cache.delete(this.cache.keys().next().value!);
+        return value;
+      })
+      .finally(() => this.flights.delete(key));
+    this.flights.set(key, flight);
+    return flight;
+  }
+
+  private async run(account: PoolAccount, model: string): Promise<PoolQuota> {
+    if (this.active >= 2) await new Promise<void>((resolve) => this.queue.push(resolve));
+    else this.active++;
+    try {
+      return await this.probe(account, model);
+    } finally {
+      const next = this.queue.shift();
+      if (next) next();
+      else this.active--;
+    }
+  }
+}
