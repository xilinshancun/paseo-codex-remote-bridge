@@ -0,0 +1,97 @@
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { createInterface } from "node:readline";
+import { once } from "node:events";
+import { poolEnvironment, type PoolAccount } from "./config";
+
+export function object(value: unknown): Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+/** Short-lived native probes. No auth files are read, transported, or logged by the plugin. */
+export class CodexRpc {
+  private readonly child: ChildProcessWithoutNullStreams;
+  private serial = 0;
+  private readonly pending = new Map<
+    number,
+    {
+      resolve: (value: unknown) => void;
+      reject: (error: Error) => void;
+      timer: ReturnType<typeof setTimeout>;
+    }
+  >();
+  private dead = false;
+  constructor(
+    account: PoolAccount,
+    private readonly timeoutMs = 25_000,
+  ) {
+    this.child = spawn(account.command[0], [...account.command.slice(1), "app-server"], {
+      env: poolEnvironment(account, process.env),
+      stdio: "pipe",
+    });
+    this.child.stderr.resume();
+    const lines = createInterface({ input: this.child.stdout });
+    lines.on("line", (line) => {
+      let message: Record<string, unknown>;
+      try {
+        message = object(JSON.parse(line));
+      } catch {
+        this.fail();
+        return;
+      }
+      if (typeof message.id !== "number") return;
+      const pending = this.pending.get(message.id);
+      if (!pending) return;
+      clearTimeout(pending.timer);
+      this.pending.delete(message.id);
+      if (message.error) pending.reject(new Error("Native Codex probe rejected a request"));
+      else pending.resolve(message.result);
+    });
+    this.child.once("error", () => this.fail());
+    this.child.once("close", () => {
+      lines.close();
+      this.fail();
+    });
+    this.child.stdin.on("error", () => this.fail());
+  }
+  private fail() {
+    this.dead = true;
+    for (const pending of this.pending.values()) {
+      clearTimeout(pending.timer);
+      pending.reject(new Error("Native Codex probe unavailable"));
+    }
+    this.pending.clear();
+  }
+  request(method: string, params: unknown = {}): Promise<unknown> {
+    if (this.dead) return Promise.reject(new Error("Native Codex probe closed"));
+    const id = ++this.serial;
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        reject(new Error("Native Codex probe timed out"));
+      }, this.timeoutMs);
+      this.pending.set(id, { resolve, reject, timer });
+      this.child.stdin.write(JSON.stringify({ id, method, params }) + "\n");
+    });
+  }
+  async initialize(): Promise<void> {
+    await this.request("initialize", {
+      clientInfo: { name: "paseo_account_pool", version: "1.0" },
+      capabilities: { experimentalApi: true },
+    });
+    this.child.stdin.write(JSON.stringify({ method: "initialized", params: {} }) + "\n");
+  }
+  async close(): Promise<void> {
+    this.fail();
+    if (this.child.exitCode !== null || this.child.signalCode !== null) return;
+    const closed = once(this.child, "close");
+    const timer = setTimeout(() => this.child.kill("SIGKILL"), 2_000);
+    this.child.kill("SIGTERM");
+    try {
+      await closed;
+    } finally {
+      clearTimeout(timer);
+    }
+  }
+}
diff --git a/server/codex-pool/runtime.ts b/server/codex-pool/runtime.ts
