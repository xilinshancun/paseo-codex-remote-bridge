new file mode 100644
index 0000000000000000000000000000000000000000..f35c9f1b7f7099a34db540d996c3f056dc17f162
--- /dev/null
+++ b/server/codex-pool/wake.ts
@@ -0,0 +1,45 @@
+import { readFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { object } from "./rpc";
+import { readPoolAccounts } from "./config";
+import { hostRpc } from "./host-rpc";
+
+/** The SDK exposes PaseoApi only inside handlers; a local startup RPC restores quiet pending recoveries. */
+export function wakePool(root: string): () => void {
+  const abort = new AbortController();
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  async function connect(): Promise<void> {
+    const configPath = join(dirname(root), "config.json");
+    if (!(await readPoolAccounts(configPath, true)).length || abort.signal.aborted) return;
+    const config = object(JSON.parse(await readFile(configPath, "utf8")));
+    for (const [pluginId, value] of Object.entries(object(config.plugins))) {
+      const source = object(value);
+      if (source.enabled === false || typeof source.path !== "string") continue;
+      const manifest = await readFile(join(source.path, "paseo-plugin.json"), "utf8").then(
+        (text) => object(JSON.parse(text)),
+        () => object(null),
+      );
+      if (manifest.id !== "account-switcher") continue;
+      await hostRpc(
+        root,
+        { type: "plugin.rpc.invoke.request", pluginId, method: "codex-pool.start", input: {} },
+        { timeoutMs: 10_000, signal: abort.signal },
+      );
+      return;
+    }
+  }
+  const attempt = () => {
+    void connect().catch(() => {
+      if (abort.signal.aborted) return;
+      console.error("Codex pool startup connection unavailable; retrying");
+      timer = setTimeout(attempt, 15_000);
+      timer.unref?.();
+    });
+  };
+  timer = setTimeout(attempt, 1_000);
+  timer.unref?.();
+  return () => {
+    abort.abort();
+    if (timer) clearTimeout(timer);
+  };
+}
