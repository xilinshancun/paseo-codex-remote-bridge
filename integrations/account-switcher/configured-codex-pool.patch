index 0000000000000000000000000000000000000000..9c1a10d433e74118288431011753d6bb64223b52
--- /dev/null
+++ b/server/codex-pool/launcher.ts
@@ -0,0 +1,181 @@
+import { spawn } from "node:child_process";
+import { createInterface } from "node:readline";
+import { once } from "node:events";
+import { readFile } from "node:fs/promises";
+import { poolEnvironment, readPoolAccounts } from "./config";
+import { transferHistory } from "./history";
+import {
+  poolPath,
+  readState,
+  RouteSchema,
+  writeState,
+  ManualRequestSchema,
+  MANUAL_TOKEN_ENV,
+  LaunchReceiptSchema,
+  matchesReceipt,
+} from "./state";
+import { object } from "./rpc";
+import { resolveAssignment } from "./assignment";
+import { readRegistry } from "../store";
+
+async function launchRoute(root: string, agentId: string | undefined) {
+  if (!agentId) return { route: null, manual: undefined };
+  const [saved, manual, receipt] = await Promise.all([
+    readState(poolPath(root, "routes", agentId), RouteSchema),
+    readState(poolPath(root, "manual", agentId), ManualRequestSchema),
+    readState(poolPath(root, "receipts", agentId), LaunchReceiptSchema),
+  ]);
+  const previousToken = saved?.token ?? null;
+  const staged = manual?.phase === "switching" || manual?.phase === "failed" ? manual.route : null;
+  if (staged && manual?.phase === "switching" && staged.token === process.env[MANUAL_TOKEN_ENV])
+    return { route: staged, manual: { route: staged, previousToken } };
+  // The menu can replace its intent after confirmation. Keep the confirmed route usable across
+  // that boundary, without shadowing a later automatic route or racing its writer.
+  if (
+    receipt?.manual &&
+    receipt.manual.previousToken === previousToken &&
+    matchesReceipt(receipt.manual.route, receipt)
+  ) {
+    return { route: receipt.manual.route, manual: receipt.manual };
+  }
+  if (!receipt?.manual && staged && matchesReceipt(staged, receipt))
+    return { route: staged, manual: undefined };
+  return { route: saved, manual: undefined };
+}
+
+async function launchAccount(
+  root: string,
+  origin: string,
+  configPath: string,
+  agentId: string | undefined,
+) {
+  const { route: initial, manual } = await launchRoute(root, agentId);
+  const chosen = manual && manual.route.token === process.env[MANUAL_TOKEN_ENV];
+  let route = initial;
+  const accounts = await readPoolAccounts(configPath, true);
+  let target = accounts.find((account) => account.id === (route?.accountId ?? origin));
+  if (chosen && (!target || target.enabled === false))
+    throw new Error("Selected account is no longer available");
+  if (route && agentId && !chosen)
+    ({ route, target } = await resolveAssignment(
+      root,
+      agentId,
+      route,
+      accounts,
+      undefined,
+      async () => (await readRegistry(root)).autoFailover.codex,
+    ));
+  if (!target || (route && target.pool !== route.pool))
+    throw new Error("Assigned Codex account is no longer enabled in the pool");
+  if (!route && target.enabled === false)
+    throw new Error("This Codex pool account is disabled for new sessions");
+  return { route, target, manual: route?.token === manual?.route.token ? manual : undefined };
+}
+function confirmedResume(
+  line: string,
+  requested: Set<string | number>,
+  expectedThread: string,
+): boolean {
+  let message;
+  try {
+    message = object(JSON.parse(line));
+  } catch {
+    return false;
+  }
+  if (
+    (typeof message.id !== "number" && typeof message.id !== "string") ||
+    !requested.delete(message.id) ||
+    message.error
+  )
+    return false;
+  if (object(object(message.result).thread).id !== expectedThread)
+    throw new Error("Codex resumed a different thread");
+  return true;
+}
+
+async function main(): Promise<void> {
+  const args = process.argv.slice(2);
+  if (["--root", "--provider", "--config", "--"].some((value, index) => args[index * 2] !== value))
+    throw new Error("Invalid pool launcher arguments");
+  const [root, origin, configPath] = [args[1], args[3], args[5]],
+    cliArgs = args.slice(7);
+  const agentId = process.env.PASEO_AGENT_ID;
+  const { route, target, manual } = await launchAccount(root, origin, configPath, agentId);
+  if (target.command.includes(process.argv[1])) throw new Error("Recursive pool command");
+  if (route && agentId) {
+    if (route.originId !== origin) throw new Error("Pool route belongs to another provider");
+    if (route.target.home !== target.home || route.target.ssh !== target.ssh)
+      throw new Error("Selected account location changed during recovery");
+    const transferred = poolPath(root, "transfers", agentId + "-" + route.token);
+    const done = await readFile(transferred, "utf8").then(
+      () => true,
+      () => false,
+    );
+    if (!done) {
+      // The daemon closes the old session before starting this process. Copying here prevents stale snapshots.
+      await transferHistory(route.source, target, route.threadId);
+      await writeState(transferred, { token: route.token });
+    }
+  }
+  const child = spawn(target.command[0], [...target.command.slice(1), ...cliArgs], {
+    env: poolEnvironment(target, process.env),
+    stdio: "pipe",
+  });
+  child.stderr.pipe(process.stderr);
+  const requested = new Set<string | number>();
+  const input = createInterface({ input: process.stdin });
+  input.on("line", (line) => {
+    try {
+      const message = object(JSON.parse(line)),
+        params = object(message.params);
+      if (
+        route &&
+        message.method === "thread/resume" &&
+        params.threadId === route.threadId &&
+        (typeof message.id === "number" || typeof message.id === "string")
+      )
+        requested.add(message.id);
+    } catch {
+      /* Preserve CLI input verbatim. */
+    }
+    if (!child.stdin.destroyed) child.stdin.write(line + "\n");
+  });
+  input.on("close", () => child.stdin.end());
+  const output = createInterface({ input: child.stdout });
+  const relay = async () => {
+    let receiptWritten = false;
+    for await (const line of output) {
+      if (route && agentId && !receiptWritten && confirmedResume(line, requested, route.threadId)) {
+        // Once Paseo sees success it can immediately start a turn on this account.
+        // Publish the receipt first so even a plugin crash cannot reopen the old copy.
+        await writeState(poolPath(root, "receipts", agentId), {
+          token: route.token,
+          accountId: target.id,
+          threadId: route.threadId,
+          ...(manual ? { manual } : {}),
+        });
+        receiptWritten = true;
+      }
+      if (!process.stdout.write(line + "\n")) await once(process.stdout, "drain");
+    }
+  };
+  child.stdin.on("error", () => {});
+  const signals = ["SIGTERM", "SIGINT", "SIGHUP"] as const;
+  for (const signal of signals) process.on(signal, () => child.kill(signal));
+  try {
+    const [[code, signal]] = await Promise.all([once(child, "close"), relay()]);
+    process.exitCode = code ?? (signal ? 1 : 0);
+  } finally {
+    input.close();
+    output.close();
+    child.stdin.destroy();
+    child.kill("SIGTERM");
+  }
+}
+
+void main().catch(() => {
+  process.stderr.write(
+    "Codex account pool: launch or conversation recovery failed; no empty replacement thread was created.\n",
+  );
+  process.exitCode = 1;
+});
diff --git a/server/codex-pool/manual.ts b/server/codex-pool/manual.ts
