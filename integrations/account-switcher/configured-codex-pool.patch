index 0000000000000000000000000000000000000000..ce009e730c18d90b2075bfaa8b04a40ee7e2d36d
--- /dev/null
+++ b/server/codex-pool/manual.ts
@@ -0,0 +1,326 @@
+import { randomUUID } from "node:crypto";
+import { readdir, rm } from "node:fs/promises";
+import { join } from "node:path";
+import type { ModelAccountState } from "../../shared/model-account";
+import type { PoolAccount } from "./config";
+import type { PoolAgent, PoolPorts } from "./coordinator";
+import type { HistoryLocation } from "./history";
+import { HostRpcIndeterminateError } from "./host-rpc";
+import {
+  LaunchReceiptSchema,
+  ManualRequestSchema,
+  PoolBindingSchema,
+  RouteSchema,
+  matchesReceipt,
+  poolPath,
+  readState,
+  writeState,
+  type ManualRequest,
+  type PoolRoute,
+} from "./state";
+
+const UPDATE_HOST =
+  "Update the Paseo daemon to switch accounts without interrupting a running turn.";
+const MISSING_THREAD = "Start or resume this conversation, then select the account again.";
+const MISSING_MODEL = "Choose a model for this conversation, then select the account again.";
+interface Source {
+  id: string;
+  pool: string;
+  location: HistoryLocation;
+}
+type ManualPorts = Pick<
+  PoolPorts,
+  "accounts" | "inspect" | "probe" | "now" | "confirm" | "reloadIfIdle" | "supportsIdleReload"
+>;
+
+function label(id: string, accounts: PoolAccount[]) {
+  const name = accounts.find((account) => account.id === id)?.label ?? id;
+  return { id, label: /^Codex\s*·\s*账号\s*([A-Z])$/.exec(name)?.[1] ?? name };
+}
+
+/** A proposed manual route is visible only to the guarded interactive refresh until Codex resumes the thread. */
+export async function confirmedSource(
+  root: string,
+  agent: PoolAgent,
+  accounts: PoolAccount[],
+): Promise<Source | null> {
+  const [stored, route, receipt, manual] = await Promise.all([
+    readState(poolPath(root, "bindings", agent.id), PoolBindingSchema),
+    readState(poolPath(root, "routes", agent.id), RouteSchema),
+    readState(poolPath(root, "receipts", agent.id), LaunchReceiptSchema),
+    readState(poolPath(root, "manual", agent.id), ManualRequestSchema),
+  ]);
+  const confirmed = [receipt?.manual?.route, manual?.route, route].find(
+    (candidate) =>
+      candidate &&
+      candidate.originId === agent.provider &&
+      candidate.threadId === agent.threadId &&
+      matchesReceipt(candidate, receipt),
+  );
+  if (confirmed)
+    return { id: confirmed.accountId, pool: confirmed.pool, location: confirmed.target };
+  if (route?.originId === agent.provider && route.threadId === agent.threadId) {
+    // A binding is committed after native confirmation, and remains valid if the receipt is lost.
+    if (!receipt && stored?.accountId === route.accountId && stored.originId === route.originId)
+      return { id: stored.accountId, pool: stored.pool, location: stored.location };
+    return { id: route.sourceId, pool: route.pool, location: route.source };
+  }
+  if (stored?.originId === agent.provider)
+    return { id: stored.accountId, pool: stored.pool, location: stored.location };
+  const origin = accounts.find((a) => a.id === agent.provider);
+  return origin ? { id: origin.id, pool: origin.pool, location: location(origin) } : null;
+}
+
+function location(account: PoolAccount): HistoryLocation {
+  return { home: account.home, ...(account.ssh ? { ssh: account.ssh } : {}) };
+}
+
+export class ManualAccountSwitches {
+  readonly active = new Set<string>();
+  private writes: Promise<unknown> = Promise.resolve();
+  constructor(
+    private readonly root: string,
+    private readonly ports: ManualPorts,
+  ) {}
+  private path(id: string) {
+    return poolPath(this.root, "manual", id);
+  }
+  get(id: string) {
+    return readState(this.path(id), ManualRequestSchema);
+  }
+  private edit<T>(operation: () => Promise<T>): Promise<T> {
+    const task = this.writes.catch(() => {}).then(operation);
+    this.writes = task;
+    return task;
+  }
+  private async context(id: string) {
+    const agent = await this.ports.inspect(id);
+    if (!agent || agent.archived) return null;
+    const accounts = await this.ports.accounts(true);
+    const source = await confirmedSource(this.root, agent, accounts);
+    if (!source) return null;
+    return { agent, accounts, source };
+  }
+  async read(id: string): Promise<ModelAccountState | null> {
+    const context = await this.context(id);
+    if (!context) return null;
+    const { agent, accounts, source } = context;
+    const [request, canSwitch] = await Promise.all([this.get(id), this.ports.supportsIdleReload()]);
+    const pending =
+      request?.phase === "queued" || request?.phase === "switching"
+        ? { accountId: request.accountId, phase: request.phase }
+        : null;
+    const failedHere =
+      request?.phase === "failed" &&
+      request.sourceId === source.id &&
+      (request.errorExpiresAt ?? 0) > this.ports.now();
+    const error = failedHere ? request.error : null;
+    return {
+      origin: label(agent.provider, accounts),
+      current: label(source.id, accounts),
+      accounts: accounts
+        .filter((a) => a.pool === source.pool && a.enabled !== false)
+        .map((a) => label(a.id, accounts)),
+      pending,
+      canSwitch,
+      error: canSwitch ? error : UPDATE_HOST,
+    };
+  }
+  async select(id: string, accountId: string): Promise<void> {
+    const context = await this.context(id);
+    if (!context) throw new Error("This conversation is not in a configured Codex account pool.");
+    if (!context.agent.busy && !context.agent.threadId) throw new Error(MISSING_THREAD);
+    if (!context.agent.busy && !context.agent.model) throw new Error(MISSING_MODEL);
+    if (!(await this.ports.supportsIdleReload())) throw new Error(UPDATE_HOST);
+    const { agent, accounts, source } = context;
+    if (!accounts.some((a) => a.pool === source.pool && a.id === accountId && a.enabled !== false))
+      throw new Error("This account is not enabled in this conversation's pool.");
+    await this.edit(async () => {
+      const existing = await this.get(id);
+      if (existing?.phase === "switching") throw new Error("An account switch is in progress.");
+      if (source.id === accountId) {
+        await rm(this.path(id), { force: true });
+        this.active.delete(id);
+        return;
+      }
+      await writeState(this.path(id), {
+        agentId: id,
+        token: randomUUID(),
+        accountId,
+        sourceId: source.id,
+        originId: agent.provider,
+        threadId: agent.threadId,
+        pool: source.pool,
+        phase: "queued",
+      } satisfies ManualRequest);
+      this.active.add(id);
+    });
+  }
+  async cancel(id: string) {
+    if (!(await this.ports.inspect(id))) throw new Error("Conversation unavailable.");
+    await this.edit(async () => {
+      const current = await this.get(id);
+      if (current?.phase === "switching")
+        throw new Error("The account switch has already started.");
+      if (current?.phase === "queued" || current?.phase === "failed")
+        await rm(this.path(id), { force: true });
+      this.active.delete(id);
+    });
+  }
+  async restore() {
+    for (const file of await readdir(join(this.root, "codex-pool", "manual")).catch(() => [])) {
+      if (!file.endsWith(".json")) continue;
+      await this.edit(async () => {
+        const entry = await this.get(decodeURIComponent(file.slice(0, -5)));
+        if (entry && (entry.phase === "queued" || entry.phase === "switching"))
+          this.active.add(entry.agentId);
+      });
+    }
+  }
+  private update(request: ManualRequest, next: ManualRequest) {
+    return this.edit(async () => {
+      const current = await this.get(request.agentId);
+      if (current?.token !== request.token || current.phase !== request.phase) return false;
+      await writeState(this.path(request.agentId), next);
+      if (next.phase === "failed" || next.phase === "applied") this.active.delete(request.agentId);
+      return true;
+    });
+  }
+  private fail(request: ManualRequest, error: string) {
+    return this.update(request, {
+      ...request,
+      phase: "failed",
+      error,
+      errorExpiresAt: this.ports.now() + 300_000,
+    });
+  }
+  private async commit(request: ManualRequest, route: PoolRoute) {
+    const id = request.agentId;
+    // A crash between these writes will reconcile the same staged route with the same native receipt.
+    await writeState(poolPath(this.root, "routes", id), route);
+    await writeState(poolPath(this.root, "bindings", id), {
+      originId: route.originId,
+      accountId: route.accountId,
+      pool: route.pool,
+      location: route.target,
+    });
+    await this.update(request, { ...request, phase: "applied" });
+  }
+  private async reconcile(request: ManualRequest): Promise<boolean> {
+    if (request.phase === "switching" && request.route) {
+      const receipt = await readState(
+        poolPath(this.root, "receipts", request.agentId),
+        LaunchReceiptSchema,
+      );
+      if (matchesReceipt(request.route, receipt)) {
+        await this.commit(request, request.route);
+        return true;
+      }
+      if ((request.retryAt ?? 0) > this.ports.now()) return true;
+    }
+    return false;
+  }
+  /** Called while holding the same per-agent flight as automatic selection. */
+  async apply(id: string): Promise<void> {
+    const request = await this.get(id);
+    if (!request || !this.active.has(id)) return;
+    if (await this.reconcile(request)) return;
+    const context = await this.context(id);
+    if (
+      !context ||
+      context.agent.provider !== request.originId ||
+      context.source.pool !== request.pool
+    ) {
+      await this.fail(request, "The original conversation is no longer available.");
+      return;
+    }
+    const { agent, accounts, source } = context;
+    if (agent.busy) return;
+    if (!agent.threadId || !agent.model) {
+      await this.fail(request, !agent.threadId ? MISSING_THREAD : MISSING_MODEL);
+      return;
+    }
+    if (request.threadId && agent.threadId !== request.threadId) {
+      await this.fail(request, "The original conversation is no longer available.");
+      return;
+    }
+    const target = await this.eligibleTarget(request, accounts, agent.model);
+    if (!target) return;
+    const latest = await this.ports.inspect(id);
+    if (
+      !latest ||
+      latest.archived ||
+      latest.busy ||
+      latest.threadId !== agent.threadId ||
+      latest.model !== agent.model
+    )
+      return;
+    const route: PoolRoute = {
+      token: request.token,
+      originId: agent.provider,
+      accountId: target.id,
+      threadId: agent.threadId,
+      model: agent.model,
+      pool: source.pool,
+      sourceId: source.id,
+      source: source.location,
+      target: location(target),
+    };
+    const switching: ManualRequest = {
+      ...request,
+      phase: "switching",
+      route,
+      threadId: route.threadId,
+      lastUserMessageAt: latest.lastUserMessageAt,
+      retryAt: this.ports.now() + 180_000,
+    };
+    if (!(await this.update(request, switching))) return;
+    await this.reload(switching, route);
+  }
+
+  private async eligibleTarget(request: ManualRequest, accounts: PoolAccount[], model: string) {
+    const target = accounts.find(
+      (a) => a.id === request.accountId && a.pool === request.pool && a.enabled !== false,
+    );
+    if (!target) {
+      await this.fail(request, "The selected account is no longer in this pool.");
+      return null;
+    }
+    const quota = await this.ports.probe(target, model);
+    if (quota.status !== "available" || !quota.identity) {
+      await this.fail(request, "The selected account has no verified capacity for this model.");
+      return null;
+    }
+    return target;
+  }
+
+  private async reload(switching: ManualRequest, route: PoolRoute) {
+    const id = switching.agentId;
+    try {
+      const result = await this.ports.reloadIfIdle(id, switching.token);
+      if (result === "busy") {
+        await this.update(switching, {
+          ...switching,
+          phase: "queued",
+          route: undefined,
+          retryAt: undefined,
+        });
+        return;
+      }
+      if (await this.ports.confirm(id, route)) await this.commit(switching, route);
+      // A slow remote resume can finish after the daemon acknowledged the reload.
+      // Reconcile its receipt before admitting another guarded attempt.
+    } catch (error) {
+      const receipt = await readState(poolPath(this.root, "receipts", id), LaunchReceiptSchema);
+      if (matchesReceipt(route, receipt)) {
+        await this.commit(switching, route);
+        return;
+      }
+      if (error instanceof HostRpcIndeterminateError) return;
+      await this.fail(
+        switching,
+        "Could not switch accounts. Check the selected account and try again.",
+      );
+    }
+  }
+}
