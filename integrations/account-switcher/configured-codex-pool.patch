+const models = { data: [{ id: "exact-model" }] };
+const parse = (rate: unknown = rates, identity: unknown = account, catalog: unknown = models) =>
+  parsePoolQuota("custom", identity, rate, catalog, "exact-model", now);
+
+describe("configured Codex pool", () => {
