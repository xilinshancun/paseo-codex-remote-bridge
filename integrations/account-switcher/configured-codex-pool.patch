@@ -0,0 +1,92 @@
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { z } from "zod";
+import { atomicWrite, isMissing } from "../files";
+
+export const PoolBindingSchema = z.object({
+  originId: z.string(),
+  accountId: z.string(),
+  pool: z.string(),
+  location: z.object({ home: z.string(), ssh: z.string().optional() }),
+});
+export const RouteSchema = z.object({
+  token: z.string().uuid(),
+  accountId: z.string(),
+  originId: z.string(),
+  pool: z.string(),
+  threadId: z.string().uuid(),
+  model: z.string(),
+  source: z.object({ home: z.string(), ssh: z.string().optional() }),
+  sourceId: z.string(),
+  target: z.object({ home: z.string(), ssh: z.string().optional() }),
+});
+export type PoolRoute = z.infer<typeof RouteSchema>;
+export const LaunchReceiptSchema = z.object({
+  token: z.string(),
+  accountId: z.string(),
+  threadId: z.string(),
+  manual: z.object({ route: RouteSchema, previousToken: z.string().nullable() }).optional(),
+});
+export const ManualRequestSchema = z.object({
+  agentId: z.string(),
+  token: z.string().uuid(),
+  accountId: z.string(),
+  originId: z.string(),
+  threadId: z.string().nullable(),
+  pool: z.string(),
+  phase: z.enum(["queued", "switching", "applied", "failed"]),
+  route: RouteSchema.optional(),
+  lastUserMessageAt: z.string().nullable().optional(),
+  retryAt: z.number().optional(),
+  sourceId: z.string().optional(),
+  error: z.string().optional(),
+  errorExpiresAt: z.number().optional(),
+});
+export type ManualRequest = z.infer<typeof ManualRequestSchema>;
+export const MANUAL_TOKEN_ENV = "PASEO_CODEX_MANUAL_SWITCH";
+export function matchesReceipt(
+  route: PoolRoute,
+  receipt: z.infer<typeof LaunchReceiptSchema> | null,
+) {
+  return (
+    receipt?.token === route.token &&
+    receipt.threadId === route.threadId &&
+    receipt.accountId === route.accountId
+  );
+}
+
+export const ReopenRequestSchema = z.object({
+  agentId: z.string(),
+  threadId: z.string().uuid(),
+  token: z.string().uuid(),
+});
+export const RecoverySchema = z.object({
+  agentId: z.string(),
+  cause: z.enum(["quota", "account-unavailable"]).optional(),
+  originId: z.string(),
+  pool: z.string(),
+  turnKey: z.string(),
+  stopPending: z.boolean().optional(),
+  phase: z.enum(["waiting", "switching", "sending", "continued", "paused"]),
+  model: z.string(),
+  threadId: z.string().uuid(),
+  sourceId: z.string(),
+  source: z.object({ home: z.string(), ssh: z.string().optional() }),
+  excluded: z.array(z.string()),
+  retryAt: z.number(),
+  token: z.string().uuid().optional(),
+  lastUserMessageAt: z.string().nullable(),
+});
+export type PoolRecovery = z.infer<typeof RecoverySchema>;
+export const poolPath = (root: string, kind: string, id: string) =>
+  join(root, "codex-pool", kind, encodeURIComponent(id) + ".json");
+export async function readState<T>(path: string, schema: z.ZodType<T>): Promise<T | null> {
+  try {
+    return schema.parse(JSON.parse(await readFile(path, "utf8")));
+  } catch (error) {
+    if (isMissing(error)) return null;
+    throw error;
+  }
+}
+export const writeState = (path: string, value: unknown) =>
+  atomicWrite(path, JSON.stringify(value, null, 2));
