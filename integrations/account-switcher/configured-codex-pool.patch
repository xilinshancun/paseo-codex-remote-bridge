diff --git a/server/codex-pool/assignment.ts b/server/codex-pool/assignment.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c2857173dd6ce36bf8042a5d932741bedee31ee
--- /dev/null
+++ b/server/codex-pool/assignment.ts
@@ -0,0 +1,57 @@
+import { randomUUID } from "node:crypto";
+import type { PoolAccount } from "./config";
+import { probePoolAccount, selectPoolAccount, type PoolQuota } from "./quota";
+import { poolPath, readState, writeState, LaunchReceiptSchema, type PoolRoute } from "./state";
+
+/** A removed account must not make a previously transferred conversation impossible to reopen. */
+export async function resolveAssignment(
+  root: string,
+  agentId: string,
+  route: PoolRoute,
+  accounts: PoolAccount[],
+  probe: (account: PoolAccount, model: string) => Promise<PoolQuota> = probePoolAccount,
+  allowSwitch: () => Promise<boolean> = async () => true,
+): Promise<{ route: PoolRoute; target: PoolAccount }> {
+  const assigned = accounts.find(
+    (account) =>
+      account.id === route.accountId && account.pool === route.pool && account.enabled !== false,
+  );
+  if (assigned && assigned.home === route.target.home && assigned.ssh === route.target.ssh)
+    return { route, target: assigned };
+  if (!(await allowSwitch())) throw new Error("Automatic Codex account switching is disabled");
+  const eligible = accounts.filter(
+    (account) => account.pool === route.pool && account.enabled !== false,
+  );
+  const quotas: PoolQuota[] = [];
+  for (let index = 0; index < eligible.length; index += 2)
+    quotas.push(
+      ...(await Promise.all(
+        eligible.slice(index, index + 2).map((account) => probe(account, route.model)),
+      )),
+    );
+  const target = selectPoolAccount(eligible, quotas, new Set(), Date.now());
+  if (!target) {
+    // Startup errors do not always emit turn_ended. The plugin drains this durable request independently.
+    await writeState(poolPath(root, "reopen-requests", agentId), {
+      agentId,
+      threadId: route.threadId,
+      token: route.token,
+    });
+    throw new Error("No configured Codex account can reopen this conversation yet");
+  }
+  const receipt = await readState(poolPath(root, "receipts", agentId), LaunchReceiptSchema);
+  const confirmed =
+    receipt?.token === route.token &&
+    receipt.accountId === route.accountId &&
+    receipt.threadId === route.threadId;
+  const next: PoolRoute = {
+    ...route,
+    token: randomUUID(),
+    accountId: target.id,
+    sourceId: confirmed ? route.accountId : route.sourceId,
+    source: confirmed ? route.target : route.source,
+    target: { home: target.home, ...(target.ssh ? { ssh: target.ssh } : {}) },
+  };
+  await writeState(poolPath(root, "routes", agentId), next);
+  return { route: next, target };
+}
diff --git a/server/codex-pool/config.ts b/server/codex-pool/config.ts
new file mode 100644
index 0000000000000000000000000000000000000000..71d47721c9aca43ae85e8ac70774e0e61ebf03bc
--- /dev/null
+++ b/server/codex-pool/config.ts
@@ -0,0 +1,87 @@
+import { readFile } from "node:fs/promises";
+import { isAbsolute } from "node:path";
+import { z } from "zod";
+
+export const POOL_ENV = "PASEO_CODEX_ACCOUNT_POOL";
+const Membership = z.object({
+  pool: z.string().min(1),
+  enabled: z.boolean().optional(),
+  command: z.array(z.string().min(1)).min(1),
+  home: z.string().refine(isAbsolute, "Use an absolute Codex home on the account's host"),
+  ssh: z
+    .string()
+    .regex(/^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*$/)
+    .optional(),
+});
+export const PoolAccountSchema = Membership.extend({
+  id: z.string(),
+  label: z.string(),
+  env: z.record(z.string(), z.string()),
+});
+export type PoolAccount = z.infer<typeof PoolAccountSchema>;
+
+/** Explicit membership avoids treating arbitrary OpenAI-compatible providers as subscription accounts. */
+export function poolAccounts(config: unknown, includeDisabled = false): PoolAccount[] {
+  const providers =
+    z
+      .object({
+        agents: z.object({ providers: z.record(z.string(), z.unknown()).optional() }).optional(),
+      })
+      .parse(config).agents?.providers ?? {};
+  const Provider = z.object({
+    extends: z.string().optional(),
+    enabled: z.boolean().optional(),
+    label: z.string().optional(),
+    env: z.record(z.string(), z.string()).optional(),
+  });
+  const result: PoolAccount[] = [];
+  for (const [id, rawProvider] of Object.entries(providers)) {
+    const parsed = Provider.safeParse(rawProvider);
+    if (!parsed.success) {
+      console.warn(`Codex pool skipped invalid provider ${id}`);
+      continue;
+    }
+    const provider = parsed.data;
+    if (id !== "codex" && provider.extends !== "codex") continue;
+    const raw = provider.env?.[POOL_ENV];
+    if (!raw) continue;
+    try {
+      const membership = Membership.parse(JSON.parse(raw));
+      if (!isAbsolute(membership.command[0])) throw new Error("Pool commands must be absolute");
+      const enabled = provider.enabled !== false && membership.enabled !== false;
+      if (!enabled && !includeDisabled) continue;
+      result.push({
+        ...membership,
+        enabled,
+        id,
+        label: provider.label ?? id,
+        env: provider.env ?? {},
+      });
+    } catch {
+      console.warn(`Codex pool skipped invalid membership for ${id}`);
+    }
+  }
+  return result;
+}
+export async function readPoolAccounts(
+  configPath: string,
+  includeDisabled = false,
+): Promise<PoolAccount[]> {
+  return poolAccounts(JSON.parse(await readFile(configPath, "utf8")), includeDisabled);
+}
+
+/** A target receives its own provider overrides, never the source account's auth or proxy overrides. */
+export function poolEnvironment(account: PoolAccount, base: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  const env = { ...base };
+  for (const key of Object.keys(env)) {
+    if (
+      /^(CODEX_|OPENAI_|PASEO_CODEX_|ANTHROPIC_|CLAUDE_)/.test(key) ||
+      /^(https?|all|no)_proxy$/i.test(key)
+    )
+      delete env[key];
+  }
+  Object.assign(env, account.env);
+  delete env[POOL_ENV];
+  if (!account.ssh) env.CODEX_HOME = account.home;
+  return env;
+}
diff --git a/server/codex-pool/coordinator.ts b/server/codex-pool/coordinator.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b04fa84dc5d4153c288acd5f7b08a40c9e037abc
--- /dev/null
+++ b/server/codex-pool/coordinator.ts
@@ -0,0 +1,617 @@
+import { randomUUID } from "node:crypto";
+import { readdir } from "node:fs/promises";
+import { join } from "node:path";
+import { ManualAccountSwitches, confirmedSource } from "./manual";
+import type { PoolAccount } from "./config";
+import type { HistoryLocation } from "./history";
+import { isQuotaFailure, selectPoolAccount, type PoolQuota } from "./quota";
+import {
+  poolPath,
+  readState,
+  RecoverySchema,
+  RouteSchema,
+  LaunchReceiptSchema,
+  writeState,
+  type PoolRecovery,
+  type PoolRoute,
+} from "./state";
+
+export class PoolReloadPendingError extends Error {}
+
+export interface PoolAgent {
+  id: string;
+  provider: string;
+  model: string | null;
+  threadId: string | null;
+  busy: boolean;
+  archived: boolean;
+  lastUserMessageAt: string | null;
+}
+export interface PoolPorts {
+  accounts(includeDisabled?: boolean): Promise<PoolAccount[]>;
+  enabled(): Promise<boolean>;
+  inspect(id: string): Promise<PoolAgent | null>;
+  probe(account: PoolAccount, model: string): Promise<PoolQuota>;
+  supportsIdleReload(): Promise<boolean>;
+  reloadIfIdle(id: string, requestId: string): Promise<"busy" | "reloaded">;
+  reload(id: string, guard: () => Promise<boolean>): Promise<void>;
+  stop(id: string, messageId: string): Promise<void>;
+  confirm(id: string, route: PoolRoute): Promise<boolean>;
+  send(id: string, messageId: string): Promise<void>;
+  sent(id: string, messageId: string): Promise<boolean>;
+  note(
+    id: string,
+    recovery: PoolRecovery,
+    state: "waiting" | "switching" | "auto" | "failed" | "paused" | "checking",
+    target: PoolAccount | null,
+    error?: string,
+  ): Promise<void>;
+  now(): number;
+}
+
+/** One recovery per agent. Files are private durable intentions; the launcher is the account/host boundary. */
+export class PoolCoordinator {
+  private readonly flights = new Map<string, Promise<void>>();
+  private readonly generations = new Map<string, number>();
+  private readonly timers = new Map<string, ReturnType<typeof setTimeout>>();
+  private readonly ownSends = new Set<string>();
+  private readonly handled = new Map<string, Set<string>>();
+  private readonly pendingFailures = new Map<string, { turnKey: string; message: string }>();
+  private readonly turnEpochs = new Map<string, string>();
+  private stateQueue = Promise.resolve();
+  private readonly notes = new Map<string, Promise<void>>();
+  private disposed = false;
+  readonly manual: ManualAccountSwitches;
+  constructor(
+    readonly root: string,
+    private readonly ports: PoolPorts,
+  ) {
+    this.manual = new ManualAccountSwitches(root, ports);
+  }
+
+  runManual(id: string): Promise<void> {
+    if (this.disposed || !this.manual.active.has(id) || this.flights.has(id))
+      return Promise.resolve();
+    const task = this.manual.apply(id).finally(() => this.finished(id));
+    this.flights.set(id, task);
+    return task;
+  }
+
+  private statePath(id: string) {
+    return poolPath(this.root, "recoveries", id);
+  }
+  private routePath(id: string) {
+    return poolPath(this.root, "routes", id);
+  }
+  private generation(id: string) {
+    return this.generations.get(id) ?? 0;
+  }
+  private valid(id: string, generation: number) {
+    return !this.disposed && this.generation(id) === generation;
+  }
+
+  // Serialize only local state I/O. A slow host operation must never hold up the Pause RPC.
+  private editState<T>(edit: () => Promise<T>): Promise<T> {
+    const result = this.stateQueue.then(edit);
+    this.stateQueue = result.then(
+      () => undefined,
+      () => undefined,
+    );
+    return result;
+  }
+
+  private save(recovery: PoolRecovery, generation: number): Promise<boolean> {
+    return this.editState(async () => {
+      if (!this.valid(recovery.agentId, generation)) return false;
+      await writeState(this.statePath(recovery.agentId), recovery);
+      return this.valid(recovery.agentId, generation);
+    });
+  }
+
+  private invalidate(id: string): number {
+    this.generations.set(id, this.generation(id) + 1);
+    const timer = this.timers.get(id);
+    if (timer) clearTimeout(timer);
+    this.timers.delete(id);
+    return this.generation(id);
+  }
+
+  async cancel(id: string): Promise<void> {
+    const generation = this.invalidate(id);
+    await this.editState(async () => {
+      const recovery = await readState(this.statePath(id), RecoverySchema);
+      if (!recovery || !this.valid(id, generation)) return;
+      if (recovery.stopPending) this.schedule({ ...recovery, retryAt: this.ports.now() });
+      if (recovery.phase !== "continued" && recovery.phase !== "paused")
+        await writeState(this.statePath(id), { ...recovery, phase: "paused" });
+    });
+  }
+
+  /** A user's new task takes ownership. The continuation's own turn_started event does not cancel itself. */
+  started(id: string): void {
+    // Codex's adapter can restart its turn counter at zero after reload. A live turn, not that counter, owns deduplication.
+    this.turnEpochs.set(id, randomUUID());
+    if (!this.ownSends.has(id)) void this.cancel(id).catch(() => {});
+  }
+
+  async failed(id: string, turnKey: string, message: string): Promise<void> {
+    if (!isQuotaFailure(message) && message !== "codex-pool.account-unavailable") return;
+    return this.processFailure(id, `${this.turnEpochs.get(id) ?? "initial"}:${turnKey}`, message);
+  }
+
+  private async processFailure(id: string, scopedTurnKey: string, message: string): Promise<void> {
+    if (this.disposed) return;
+    if (this.flights.has(id)) {
+      this.pendingFailures.set(id, { turnKey: scopedTurnKey, message });
+      return;
+    }
+    const handled = this.handled.get(id) ?? new Set<string>();
+    if (handled.has(scopedTurnKey)) return;
+    const generation = this.generation(id);
+    const task = this.begin(id, scopedTurnKey, message, generation)
+      .catch(async () => {
+        if (!this.valid(id, generation)) return;
+        const recovery = await readState(this.statePath(id), RecoverySchema).catch(() => null);
+        if (recovery && recovery.phase !== "paused" && recovery.phase !== "continued") {
+          this.schedule({ ...recovery, retryAt: this.ports.now() + 60_000 });
+        } else {
+          this.handled.get(id)?.delete(scopedTurnKey);
+          const timer = setTimeout(() => {
+            this.timers.delete(id);
+            if (this.valid(id, generation)) return this.processFailure(id, scopedTurnKey, message);
+          }, 60_000);
+          timer.unref?.();
+          this.timers.set(id, timer);
+        }
+      })
+      .finally(() => this.finished(id));
+    this.flights.set(id, task);
+    await task;
+  }
+
+  private finished(id: string): void {
+    this.flights.delete(id);
+    const pending = this.pendingFailures.get(id);
+    this.pendingFailures.delete(id);
+    if (pending && !this.disposed)
+      void this.processFailure(id, pending.turnKey, pending.message).catch(() => {});
+  }
+
+  private sameTask(recovery: PoolRecovery, agent: PoolAgent): boolean {
+    return (
+      recovery.threadId === agent.threadId && recovery.lastUserMessageAt === agent.lastUserMessageAt
+    );
+  }
+
+  private async readyAgent(
+    id: string,
+  ): Promise<(PoolAgent & { model: string; threadId: string }) | null> {
+    const agent = await this.ports.inspect(id);
+    // refresh reads persisted agents too. Null means gone or no longer visible; transport failures throw.
+    if (!agent || agent.archived) return null;
+    if (agent.busy || !agent.model || !agent.threadId)
+      throw new Error("Agent temporarily unavailable for recovery");
+    return { ...agent, model: agent.model, threadId: agent.threadId };
+  }
+
+  private async begin(
+    id: string,
+    turnKey: string,
+    message: string,
+    generation: number,
+  ): Promise<void> {
+    if (!(await this.ports.enabled())) return;
+    const agent = await this.readyAgent(id);
+    if (!agent) return;
+    const source = await this.resolveSource(agent);
+    if (!source) return;
+    if (!this.valid(id, generation)) return;
+    const before = await readState(this.statePath(id), RecoverySchema);
+    if (before?.phase === "paused" && this.sameTask(before, agent)) return;
+    if (before?.turnKey === turnKey && before.phase !== "waiting") return;
+    const handled = this.handled.get(id) ?? new Set<string>();
+    handled.add(turnKey);
+    if (handled.size > 256) handled.delete(handled.values().next().value!);
+    this.handled.set(id, handled);
+    const recovery: PoolRecovery = {
+      agentId: id,
+      cause: isQuotaFailure(message) ? "quota" : "account-unavailable",
+      originId: agent.provider,
+      pool: source.pool,
+      turnKey,
+      phase: "waiting",
+      model: agent.model,
+      threadId: agent.threadId,
+      sourceId: source.id,
+      source: source.location,
+      excluded: [source.id],
+      retryAt: this.ports.now(),
+      lastUserMessageAt: agent.lastUserMessageAt,
+    };
+    if (
+      before &&
+      before.phase !== "continued" &&
+      before.phase !== "paused" &&
+      this.sameTask(before, agent)
+    ) {
+      await this.recover(before, generation);
+      return;
+    }
+    if (!(await this.save(recovery, generation))) return;
+    await this.recover(recovery, generation);
+  }
+
+  private async resolveSource(
+    agent: PoolAgent,
+  ): Promise<{ id: string; pool: string; location: HistoryLocation } | null> {
+    return confirmedSource(this.root, agent, await this.ports.accounts(true));
+  }
+
+  private note(generation: number, ...args: Parameters<PoolPorts["note"]>): Promise<void> {
+    const [id] = args;
+    const task = (this.notes.get(id) ?? Promise.resolve())
+      .then(() => (this.valid(id, generation) ? this.ports.note(...args) : undefined))
+      .catch(() => console.error("Codex pool timeline update failed"));
+    this.notes.set(id, task);
+    return task.finally(() => {
+      if (this.notes.get(id) === task) this.notes.delete(id);
+    });
+  }
+
+  async pause(id: string, rowId: string): Promise<boolean> {
+    return this.editState(async () => {
+      const recovery = await readState(this.statePath(id), RecoverySchema);
+      if (!recovery || rowId !== "account-failover-" + id + "-pool-" + recovery.turnKey)
+        return false;
+      if (recovery.phase === "paused") {
+        void this.note(this.generation(id), id, recovery, "paused", null);
+        return true;
+      }
+      const generation = this.invalidate(id);
+      const paused: PoolRecovery = {
+        ...recovery,
+        phase: "paused",
+        stopPending:
+          recovery.stopPending || recovery.phase === "sending" || recovery.phase === "continued",
+      };
+      await writeState(this.statePath(id), paused);
+      void this.note(generation, id, paused, "paused", null);
+      if (paused.stopPending) this.schedule({ ...paused, retryAt: this.ports.now() });
+      return true;
+    });
+  }
+
+  private async unchanged(recovery: PoolRecovery, generation: number): Promise<boolean> {
+    if (!this.valid(recovery.agentId, generation)) return false;
+    const agent = await this.ports.inspect(recovery.agentId);
+    const enabled = agent && (await this.ports.enabled());
+    if (!this.valid(recovery.agentId, generation)) return false;
+    if (
+      !agent ||
+      !enabled ||
+      (agent &&
+        (agent.archived ||
+          agent.provider !== recovery.originId ||
+          (agent.model !== null && agent.model !== recovery.model) ||
+          (agent.threadId !== null && agent.threadId !== recovery.threadId) ||
+          agent.lastUserMessageAt !== recovery.lastUserMessageAt))
+    ) {
+      await this.save({ ...recovery, phase: "paused" }, generation);
+      if (agent) await this.note(generation, recovery.agentId, recovery, "paused", null);
+      return false;
+    }
+    if (!agent || agent.busy || !agent.model || !agent.threadId) {
+      this.schedule({ ...recovery, retryAt: this.ports.now() + 5_000 });
+      return false;
+    }
+    return true;
+  }
+
+  private async recover(recovery: PoolRecovery, generation: number): Promise<void> {
+    const id = recovery.agentId;
+    if (this.manual.active.has(id)) {
+      await this.manual.apply(id);
+      if (!this.valid(id, generation)) return;
+      if (this.manual.active.has(id)) {
+        this.schedule({ ...recovery, retryAt: this.ports.now() + 5_000 });
+        return;
+      }
+    }
+    const manual = await this.manual.get(id);
+    if (
+      manual?.phase === "applied" &&
+      manual.route &&
+      manual.threadId === recovery.threadId &&
+      manual.lastUserMessageAt === recovery.lastUserMessageAt &&
+      manual.token !== recovery.token
+    ) {
+      // A failed user turn may already have been moved by a queued manual switch.
+      // Only this existing automatic recovery owns the continuation.
+      const route = await readState(this.routePath(id), RouteSchema);
+      if (route?.token === manual.token) {
+        recovery = { ...recovery, token: manual.token, phase: "switching" };
+        if (!(await this.save(recovery, generation))) return;
+      }
+    }
+    await this.recoverAutomatically(recovery, generation);
+  }
+  private async recoverAutomatically(recovery: PoolRecovery, generation: number): Promise<void> {
+    const id = recovery.agentId;
+    if (await this.resumeConfirmed(recovery, generation)) return;
+    if (!(await this.unchanged(recovery, generation))) return;
+    recovery = await this.refreshSource(recovery, generation);
+    const accounts = (await this.ports.accounts()).filter(
+      (account) => account.pool === recovery.pool,
+    );
+    if (!accounts.length) {
+      this.schedule({ ...recovery, retryAt: this.ports.now() + 60_000 });
+      return;
+    }
+    await this.note(generation, id, recovery, "checking", null);
+    const quotas: PoolQuota[] = [];
+    // Limit concurrent provider processes independently of the number of configured accounts.
+    for (let index = 0; index < accounts.length; index += 2) {
+      quotas.push(
+        ...(await Promise.all(
+          accounts
+            .slice(index, index + 2)
+            .map((account) => this.ports.probe(account, recovery.model)),
+        )),
+      );
+      if (!this.valid(id, generation)) return;
+    }
+    const excluded = new Set(recovery.excluded);
+    for (const quota of quotas)
+      if (excluded.has(quota.id) && quota.identity) excluded.add(quota.identity);
+    let target = selectPoolAccount(accounts, quotas, excluded, this.ports.now());
+    while (target && (await this.unchanged(recovery, generation))) {
+      const latest = (await this.ports.accounts()).find(
+        (account) => account.id === target!.id && account.pool === recovery.pool,
+      );
+      if (!latest) {
+        excluded.add(target.id);
+        target = selectPoolAccount(accounts, quotas, excluded, this.ports.now());
+        continue;
+      }
+      // Catalog/quota probes can take time; verify the actual selected configuration again immediately before launch.
+      const fresh = await this.ports.probe(latest, recovery.model);
+      if (fresh.status !== "available" || !fresh.identity || excluded.has(fresh.identity)) {
+        excluded.add(latest.id);
+        target = selectPoolAccount(accounts, quotas, excluded, this.ports.now());
+        continue;
+      }
+      if (!(await this.unchanged(recovery, generation))) return;
+      const switched = await this.switchAccount(recovery, generation, latest);
+      if (switched) {
+        await this.continue(switched, generation, latest);
+        return;
+      }
+      if (!this.valid(id, generation)) return;
+      excluded.add(latest.id);
+      excluded.add(fresh.identity);
+      target = selectPoolAccount(accounts, quotas, excluded, this.ports.now());
+    }
+    if (!this.valid(id, generation)) return;
+    await this.waitForCapacity(recovery, generation, quotas);
+  }
+
+  private async waitForCapacity(
+    recovery: PoolRecovery,
+    generation: number,
+    quotas: PoolQuota[],
+  ): Promise<void> {
+    const id = recovery.agentId;
+    const resets = quotas.flatMap((quota) =>
+      quota.resetAt && quota.resetAt > this.ports.now() ? [quota.resetAt] : [],
+    );
+    // A bounded refresh also notices a newly added account; a reset is only a reason to query again.
+    const retryAt = Math.min(this.ports.now() + 60_000, ...resets);
+    recovery = { ...recovery, phase: "waiting", excluded: [], retryAt };
+    if (!(await this.save(recovery, generation))) return;
+    await this.note(generation, id, recovery, "waiting", null);
+    if (this.valid(id, generation)) this.schedule(recovery);
+  }
+
+  private async refreshSource(recovery: PoolRecovery, generation: number): Promise<PoolRecovery> {
+    // A normal history view can reopen a removed assignment before our timer runs.
+    // Its confirmed rollout is now authoritative, including resume metadata written by Codex.
+    const route = await readState(this.routePath(recovery.agentId), RouteSchema);
+    const receipt = await readState(
+      poolPath(this.root, "receipts", recovery.agentId),
+      LaunchReceiptSchema,
+    );
+    if (
+      !route ||
+      receipt?.token !== route.token ||
+      receipt.accountId !== route.accountId ||
+      receipt.threadId !== recovery.threadId ||
+      route.threadId !== recovery.threadId
+    )
+      return recovery;
+    const next = { ...recovery, sourceId: route.accountId, source: route.target };
+    await this.save(next, generation);
+    return next;
+  }
+
+  private async switchAccount(
+    recovery: PoolRecovery,
+    generation: number,
+    target: PoolAccount,
+  ): Promise<PoolRecovery | null> {
+    const id = recovery.agentId,
+      token = randomUUID();
+    const route: PoolRoute = {
+      token,
+      accountId: target.id,
+      originId: recovery.originId,
+      pool: recovery.pool,
+      threadId: recovery.threadId,
+      model: recovery.model,
+      sourceId: recovery.sourceId,
+      source: recovery.source,
+      target: { home: target.home, ...(target.ssh ? { ssh: target.ssh } : {}) },
+    };
+    const switching: PoolRecovery = { ...recovery, token, phase: "switching" };
+    if (!(await this.save(switching, generation))) return null;
+    await writeState(this.routePath(id), route);
+    await this.note(generation, id, switching, "switching", target);
+    try {
+      if (!(await this.unchanged(switching, generation))) return null;
+      await this.ports.reload(id, () => this.unchanged(switching, generation));
+      if (!this.valid(id, generation)) return null;
+      if (!(await this.ports.confirm(id, route)))
+        throw new Error("Target did not confirm the original thread");
+      await writeState(poolPath(this.root, "bindings", id), {
+        originId: recovery.originId,
+        accountId: target.id,
+        pool: recovery.pool,
+        location: { home: target.home, ...(target.ssh ? { ssh: target.ssh } : {}) },
+      });
+      return switching;
+    } catch (error) {
+      if (error instanceof PoolReloadPendingError) throw error;
+      await this.note(
+        generation,
+        id,
+        switching,
+        "failed",
+        target,
+        "Account launch or history recovery failed; checking another configured account.",
+      );
+      return null;
+    }
+  }
+
+  private async resumeConfirmed(recovery: PoolRecovery, generation: number): Promise<boolean> {
+    if (!recovery.token || (recovery.phase !== "sending" && recovery.phase !== "switching"))
+      return false;
+    if (!(await this.ports.inspect(recovery.agentId))) {
+      await this.save({ ...recovery, phase: "paused" }, generation);
+      return true;
+    }
+    if (
+      recovery.phase === "sending" &&
+      (await this.ports.sent(recovery.agentId, "codex-pool-" + recovery.token))
+    ) {
+      await this.save({ ...recovery, phase: "continued" }, generation);
+      return true;
+    }
+    const route = await readState(this.routePath(recovery.agentId), RouteSchema);
+    if (!route || route.token !== recovery.token) return false;
+    const target = (await this.ports.accounts()).find(
+      (account) => account.id === route.accountId && account.pool === recovery.pool,
+    );
+    if (!target || !(await this.ports.confirm(recovery.agentId, route))) return false;
+    await this.continue(recovery, generation, target);
+    return true;
+  }
+
+  private async continue(
+    recovery: PoolRecovery,
+    generation: number,
+    target: PoolAccount,
+  ): Promise<void> {
+    const id = recovery.agentId,
+      messageId = "codex-pool-" + recovery.token;
+    if (!(await this.unchanged(recovery, generation))) return;
+    recovery = { ...recovery, phase: "sending" };
+    if (!(await this.save(recovery, generation))) return;
+    this.ownSends.add(id);
+    try {
+      if (!(await this.ports.sent(id, messageId))) {
+        if (!(await this.unchanged(recovery, generation))) return;
+        await this.ports.send(id, messageId);
+      }
+      if (await this.save({ ...recovery, phase: "continued" }, generation))
+        await this.note(generation, id, recovery, "auto", target);
+    } catch {
+      if (!this.valid(id, generation)) return;
+      // An RPC timeout can mean the prompt was accepted. Preserve the message ID and reconcile its echo.
+      this.schedule({ ...recovery, retryAt: this.ports.now() + 60_000 });
+    } finally {
+      this.ownSends.delete(id);
+    }
+  }
+
+  private schedule(recovery: PoolRecovery): void {
+    const id = recovery.agentId;
+    const previous = this.timers.get(id);
+    if (previous) clearTimeout(previous);
+    const timer = setTimeout(
+      () => {
+        this.timers.delete(id);
+        if (this.disposed) return;
+        if (this.flights.has(id)) {
+          this.schedule({ ...recovery, retryAt: this.ports.now() + 5_000 });
+          return;
+        }
+        const generation = this.generation(id);
+        const task = (async () => {
+          const latest = await readState(this.statePath(id), RecoverySchema);
+          if (latest?.phase === "paused" && latest.stopPending && latest.token) {
+            await this.ports.stop(id, "codex-pool-" + latest.token);
+            await this.save({ ...latest, stopPending: false }, generation);
+          } else if (latest && latest.phase !== "paused" && latest.phase !== "continued")
+            await this.recover(latest, generation);
+        })()
+          .catch(() => {
+            if (this.valid(id, generation))
+              this.schedule({ ...recovery, retryAt: this.ports.now() + 60_000 });
+          })
+          .finally(() => this.finished(id));
+        this.flights.set(id, task);
+        return task;
+      },
+      Math.max(1_000, recovery.retryAt - this.ports.now()),
+    );
+    timer.unref?.();
+    this.timers.set(id, timer);
+  }
+
+  async restore(): Promise<void> {
+    await this.manual.restore();
+    const directory = join(this.root, "codex-pool", "recoveries");
+    for (const file of await readdir(directory).catch(() => [])) {
+      if (!file.endsWith(".json")) continue;
+      const id = decodeURIComponent(file.slice(0, -5));
+      const generation = this.generation(id);
+      const recovery = await readState(join(directory, file), RecoverySchema);
+      if (
+        !recovery ||
+        recovery.agentId !== id ||
+        !this.valid(id, generation) ||
+        recovery.phase === "continued"
+      )
+        continue;
+      if (recovery.phase === "paused") {
+        if (recovery.stopPending) this.schedule({ ...recovery, retryAt: this.ports.now() });
+        continue;
+      }
+      try {
+        if (!(await this.ports.inspect(recovery.agentId))) {
+          await this.save({ ...recovery, phase: "paused" }, generation);
+          continue;
+        }
+        if (
+          recovery.phase === "sending" &&
+          recovery.token &&
+          (await this.ports.sent(recovery.agentId, "codex-pool-" + recovery.token))
+        ) {
+          await this.save({ ...recovery, phase: "continued" }, generation);
+          continue;
+        }
+      } catch {
+        /* A failed read must not prevent restoring the remaining chats. */
+      }
+      if (this.valid(recovery.agentId, generation))
+        this.schedule({ ...recovery, retryAt: this.ports.now() + 1_000 });
+    }
+  }
+
+  async close(): Promise<void> {
+    this.disposed = true;
+    for (const timer of this.timers.values()) clearTimeout(timer);
+    this.timers.clear();
+    await Promise.allSettled([...this.flights.values(), ...this.notes.values(), this.stateQueue]);
+  }
+}
diff --git a/server/codex-pool/history.ts b/server/codex-pool/history.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ba8d41322d551cef0fed683e3139eb8eab0bcb05
--- /dev/null
+++ b/server/codex-pool/history.ts
@@ -0,0 +1,183 @@
+import { spawn } from "node:child_process";
+import type { PoolAccount } from "./config";
+
+export type HistoryLocation = Pick<PoolAccount, "home" | "ssh">;
+
+// The stream contains only the selected rollout and its recorded descendants. It never includes auth/config/DB files.
+// Bounded chunks avoid materializing a long conversation (including its base64 expansion) in either process.
+const HISTORY_HELPER = String.raw`
+import sys,json,pathlib,base64,os,tempfile,re
+request=json.loads(sys.stdin.buffer.readline())
+home=pathlib.Path(request['home']).resolve()
+uuid=re.compile(r'^[a-fA-F0-9]{8}(?:-[a-fA-F0-9]{4}){3}-[a-fA-F0-9]{12}$')
+MAX_FILE=512*1024*1024
+MAX_TOTAL=1024*1024*1024
+def metadata(data):
+    row=json.loads(data.splitlines()[0])
+    if row.get('type')!='session_meta': raise ValueError('Invalid session metadata')
+    meta=row['payload']
+    if not uuid.fullmatch(meta.get('id','')): raise ValueError('Invalid thread ID')
+    return meta
+def parent(meta):
+    source=meta.get('source')
+    if not isinstance(source,dict): return None
+    sub=source.get('subagent',{})
+    if not isinstance(sub,dict): return None
+    spawn=sub.get('thread_spawn',{})
+    return spawn.get('parent_thread_id') if isinstance(spawn,dict) else None
+def confined(path):
+    resolved=path.resolve()
+    if not resolved.is_relative_to(home): raise ValueError('History path escapes home')
+    return resolved
+if request['operation']=='export':
+    thread=request['threadId']
+    if not uuid.fullmatch(thread): raise ValueError('Invalid thread ID')
+    entries={}
+    for directory in ['sessions','archived_sessions']:
+        root=home/directory
+        if not root.exists(): continue
+        confined(root)
+        for path in root.rglob('rollout-*.jsonl'):
+            confined(path)
+            with path.open('rb') as stream: first=stream.readline(4*1024*1024)
+            try: meta=metadata(first)
+            except (ValueError,KeyError): continue
+            entries[meta['id']]=(path,meta)
+    if thread not in entries: raise ValueError('Source thread history missing')
+    included={thread}
+    while True:
+        before=len(included)
+        included.update(key for key,(_,meta) in entries.items() if parent(meta) in included)
+        if len(included)>256: raise ValueError('Too many child histories')
+        if len(included)==before: break
+    total=0
+    for key in sorted(included):
+        path,_=entries[key];size=path.stat().st_size;total+=size
+        if size>MAX_FILE or total>MAX_TOTAL: raise ValueError('Conversation history too large')
+        header={'path':str(path.relative_to(home)),'size':size}
+        sys.stdout.buffer.write(b'F'+json.dumps(header).encode()+b'\n')
+        count=0;last=b''
+        with path.open('rb') as stream:
+            while True:
+                data=stream.read(64*1024)
+                if not data: break
+                count+=len(data);last=data[-1:]
+                if count>size: raise ValueError('Source history changed during export')
+                sys.stdout.buffer.write(b'D'+base64.b64encode(data)+b'\n')
+        if count!=size or last!=b'\n': raise ValueError('Source history incomplete')
+        sys.stdout.buffer.write(b'E\n')
+    sys.stdout.buffer.write(b'Z\n')
+elif request['operation']=='import':
+    prepared=[];temporary=[];total=0;seen=set()
+    try:
+        while True:
+            record=sys.stdin.buffer.readline(1024*1024)
+            if record==b'Z\n': break
+            if not record.startswith(b'F'): raise ValueError('Incomplete history stream')
+            header=json.loads(record[1:]);relative=pathlib.PurePosixPath(header['path']);size=header['size']
+            if relative.is_absolute() or '..' in relative.parts or relative.parts[0] not in ['sessions','archived_sessions']: raise ValueError('Invalid history path')
+            if not isinstance(size,int) or size<=0 or size>MAX_FILE: raise ValueError('Invalid history size')
+            total+=size
+            if total>MAX_TOTAL or len(prepared)>=256 or str(relative) in seen: raise ValueError('Invalid conversation archive')
+            seen.add(str(relative));target=confined(home/relative)
+            target.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
+            fd,name=tempfile.mkstemp(prefix='.pool-history-',dir=target.parent);temporary.append(name)
+            existing=target.open('rb') if target.exists() else None
+            original=target.stat() if existing else None
+            count=0;first=b'';last=b''
+            try:
+                with os.fdopen(fd,'wb') as stream:
+                    while True:
+                        record=sys.stdin.buffer.readline(128*1024)
+                        if record==b'E\n': break
+                        if not record.startswith(b'D'): raise ValueError('Incomplete file stream')
+                        data=base64.b64decode(record[1:-1],validate=True);count+=len(data)
+                        if count>size or not record.endswith(b'\n'): raise ValueError('Invalid file length')
+                        if b'\n' not in first:
+                            first+=data
+                            if len(first)>4*1024*1024: raise ValueError('Invalid session metadata')
+                        if existing and not data.startswith(existing.read(len(data))): raise ValueError('Target has divergent thread history')
+                        stream.write(data);last=data[-1:]
+                    if count!=size or last!=b'\n' or (existing and existing.read(1)): raise ValueError('History incomplete or divergent')
+                    meta=metadata(first)
+                    if not relative.name.startswith('rollout-') or not relative.name.endswith('-'+meta['id']+'.jsonl'): raise ValueError('History filename mismatch')
+                    stream.flush();os.fsync(stream.fileno())
+            finally:
+                if existing: existing.close()
+            prepared.append((target,name,original))
+        if not prepared: raise ValueError('Empty conversation archive')
+        # Validate the entire stream before committing any file. Reject changes made during the transfer.
+        for target,_,original in prepared:
+            confined(target)
+            if original:
+                current=target.stat()
+                if (current.st_ino,current.st_size,current.st_mtime_ns)!=(original.st_ino,original.st_size,original.st_mtime_ns): raise ValueError('Target changed during transfer')
+            elif target.exists(): raise ValueError('Target appeared during transfer')
+        for target,name,_ in prepared: os.replace(name,target)
+        print(json.dumps({'copied':len(prepared)}))
+    finally:
+        for name in temporary:
+            if os.path.exists(name): os.unlink(name)
+else: raise ValueError('Invalid operation')
+`;
+
+const quote = (value: string) => "'" + value.replaceAll("'", "'\\''") + "'";
+function historyProcess(location: HistoryLocation) {
+  const args = location.ssh
+    ? [
+        "-T",
+        "-o",
+        "BatchMode=yes",
+        "-o",
+        "ConnectTimeout=10",
+        "-o",
+        "ServerAliveInterval=15",
+        location.ssh,
+        "python3 -c " + quote(HISTORY_HELPER),
+      ]
+    : ["-c", HISTORY_HELPER];
+  return spawn(location.ssh ? "ssh" : "python3", args, { stdio: "pipe" });
+}
+
+export async function transferHistory(
+  source: HistoryLocation,
+  target: HistoryLocation,
+  threadId: string,
+): Promise<void> {
+  if (source.home === target.home && source.ssh === target.ssh) return;
+  const exporter = historyProcess(source),
+    importer = historyProcess(target);
+  await new Promise<void>((resolve, reject) => {
+    let remaining = 2,
+      settled = false;
+    const finish = (error?: Error) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      if (error) {
+        exporter.kill("SIGKILL");
+        importer.kill("SIGKILL");
+        reject(error);
+      } else resolve();
+    };
+    const timer = setTimeout(() => finish(new Error("Codex history transfer timed out")), 120_000);
+    for (const child of [exporter, importer]) {
+      child.stderr.resume();
+      child.once("error", () => finish(new Error("Codex history host unavailable")));
+      child.stdin.on("error", () => finish(new Error("Codex history transfer interrupted")));
+      child.once("close", (code) => {
+        if (code !== 0)
+          finish(
+            new Error(
+              "Codex history transfer refused: source missing, divergent, or outside its configured home",
+            ),
+          );
+        else if (--remaining === 0) finish();
+      });
+    }
+    importer.stdout.resume();
+    importer.stdin.write(JSON.stringify({ operation: "import", home: target.home }) + "\n");
+    exporter.stdout.pipe(importer.stdin);
+    exporter.stdin.end(JSON.stringify({ operation: "export", home: source.home, threadId }) + "\n");
+  });
+}
diff --git a/server/codex-pool/host-rpc.ts b/server/codex-pool/host-rpc.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dac439ed528920f291832eb3ebaa1e0fbb2b58cf
--- /dev/null
+++ b/server/codex-pool/host-rpc.ts
@@ -0,0 +1,145 @@
+import { readFile } from "node:fs/promises";
+import { dirname, join, isAbsolute } from "node:path";
+import { homedir } from "node:os";
+import { randomUUID } from "node:crypto";
+import { createConnection, createServer, type Socket } from "node:net";
+import { object } from "./rpc";
+
+export class HostRpcIndeterminateError extends Error {}
+
+/** Local-only transport: credentials must never be sent to an arbitrary configured hostname. */
+async function endpoint(listen: unknown): Promise<{ url: string; close(): void }> {
+  if (typeof listen !== "string") throw new Error("Local daemon endpoint is missing");
+  const local = /^(?:(127\.0\.0\.1|localhost|0\.0\.0\.0|\[::1\]|\[::\]):)?([1-9]\d*)$/.exec(listen);
+  if (local) {
+    const host = local[1]?.startsWith("[") ? "[::1]" : "127.0.0.1";
+    return { url: `ws://${host}:${local[2]}/ws`, close() {} };
+  }
+  let path = listen.startsWith("unix://") ? listen.slice(7) : listen;
+  if (path.startsWith("~/")) path = join(homedir(), path.slice(2));
+  if (!isAbsolute(path)) throw new Error("Codex pool requires a local daemon endpoint");
+  // Node's WebSocket has no Unix-socket option. A short-lived loopback bridge keeps the SDK-independent RPC local.
+  const sockets = new Set<Socket>();
+  const server = createServer((downstream) => {
+    const upstream = createConnection(path);
+    for (const socket of [upstream, downstream]) {
+      sockets.add(socket);
+      socket.on("close", () => sockets.delete(socket));
+    }
+    upstream.on("error", () => downstream.destroy());
+    downstream.on("error", () => upstream.destroy());
+    upstream.on("close", () => downstream.destroy());
+    downstream.on("close", () => upstream.destroy());
+    downstream.pipe(upstream).pipe(downstream);
+  });
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const address = server.address();
+  if (!address || typeof address === "string") {
+    server.close();
+    throw new Error("Local bridge failed to listen");
+  }
+  return {
+    url: `ws://127.0.0.1:${address.port}/ws`,
+    close() {
+      for (const socket of sockets) socket.destroy();
+      server.close();
+    },
+  };
+}
+
+export async function hostRpc(
+  root: string,
+  request: Record<string, unknown> | null,
+  options: {
+    timeoutMs?: number;
+    guard?: () => Promise<boolean>;
+    signal?: AbortSignal;
+    requiredFeature?: string;
+  } = {},
+): Promise<Record<string, unknown>> {
+  const home = dirname(root),
+    config = object(JSON.parse(await readFile(join(home, "config.json"), "utf8")));
+  const target = await endpoint(object(config.daemon).listen);
+  try {
+    const token = await readFile(join(home, "local-credential"), "utf8").then(
+      (value) => value.trim(),
+      () => "",
+    );
+    if (options.signal?.aborted) throw new Error("Local request canceled");
+    return await new Promise((resolve, reject) => {
+      const socket = new WebSocket(target.url),
+        requestId = typeof request?.requestId === "string" ? request.requestId : randomUUID();
+      let settled = false,
+        sent = false,
+        requestSent = false,
+        rejected = false;
+      const finish = (error?: Error, payload?: Record<string, unknown>) => {
+        if (settled) return;
+        settled = true;
+        clearTimeout(timer);
+        options.signal?.removeEventListener("abort", abort);
+        socket.close();
+        if (error)
+          reject(requestSent && !rejected ? new HostRpcIndeterminateError(error.message) : error);
+        else resolve(payload ?? {});
+      };
+      const abort = () => finish(new Error("Local request canceled"));
+      const timer = setTimeout(
+        () => finish(new Error("Local daemon request timed out")),
+        options.timeoutMs ?? 180_000,
+      );
+      options.signal?.addEventListener("abort", abort, { once: true });
+      socket.addEventListener("open", () =>
+        socket.send(
+          JSON.stringify({
+            type: "hello",
+            protocolVersion: 1,
+            clientId: randomUUID(),
+            clientType: "cli",
+            capabilities: {},
+            ...(token ? { auth: { kind: "localCredential", token } } : {}),
+          }),
+        ),
+      );
+      const receive = async (data: unknown) => {
+        const envelope = object(JSON.parse(String(data))),
+          message = object(envelope.message),
+          payload = object(message.payload);
+        if (envelope.type === "hello.rejected")
+          throw new Error("Local daemon rejected authentication");
+        if (!sent && message.type === "status" && payload.status === "server_info") {
+          if (!request) {
+            finish(undefined, payload);
+            return;
+          }
+          if (options.requiredFeature && object(payload.features)[options.requiredFeature] !== true)
+            throw new Error("Local daemon does not support this operation");
+          sent = true;
+          // Recheck after connecting, immediately before the mutation leaves this process.
+          if (options.guard && !(await options.guard()))
+            throw new Error("Recovery no longer owns the idle session");
+          if (!settled) {
+            socket.send(JSON.stringify({ type: "session", message: { ...request, requestId } }));
+            requestSent = true;
+          }
+        }
+        if (payload.requestId !== requestId) return;
+        if (message.type === "rpc_error" || payload.error) {
+          rejected = true;
+          throw new Error("Local daemon refused the recovery operation");
+        }
+        finish(undefined, payload);
+      };
+      socket.addEventListener("message", (event) => {
+        void receive(event.data).catch(() => finish(new Error("Local recovery RPC failed")));
+      });
+      socket.addEventListener("error", () => finish(new Error("Local daemon connection failed")));
+      socket.addEventListener("close", () => finish(new Error("Local daemon connection closed")));
+    });
+  } finally {
+    target.close();
+  }
+}
