+++ b/server/codex-pool/runtime.ts
@@ -0,0 +1,325 @@
+import { dirname, join } from "node:path";
+import type { PluginServerContext } from "@getpaseo/plugin/server";
+import { defineRpc } from "@getpaseo/plugin";
+import { z } from "zod";
+import type { PaseoApi } from "../paseo-api";
+import { atomicWrite } from "../files";
+import { readRegistry } from "../store";
+import { appendFailoverRow } from "../timeline";
+import { readPoolAccounts } from "./config";
+import {
+  PoolCoordinator,
+  PoolReloadPendingError,
+  type PoolAgent,
+  type PoolPorts,
+} from "./coordinator";
+import { isQuotaFailure, PoolQuotaReader } from "./quota";
+import { object } from "./rpc";
+import { hostRpc, HostRpcIndeterminateError } from "./host-rpc";
+import {
+  poolPath,
+  readState,
+  writeState,
+  PoolBindingSchema,
+  ManualRequestSchema,
+  MANUAL_TOKEN_ENV,
+  LaunchReceiptSchema,
+  RouteSchema,
+} from "./state";
+import { POOL_LAUNCHER_SOURCE } from "./launcher-artifact";
+import { wakePool } from "./wake";
+import {
+  readModelAccount,
+  selectModelAccount,
+  cancelModelAccount,
+} from "../../shared/model-account";
+import { pausePoolRecovery } from "../../shared/contracts";
+import { drainReopenRequests } from "./reopen";
+
+const CONTINUE =
+  "The previous turn stopped because its Codex account reached a usage limit or became unavailable. The account has now changed and this is the same conversation and workspace. Continue the user's unfinished task from the existing history. Check the recorded progress and any running or completed child tasks before repeating work. Preserve the existing scope and permissions; continue until the requested work is complete or a real external blocker requires the user.";
+
+export function registerCodexPool(server: PluginServerContext, root: string) {
+  const configPath = join(dirname(root), "config.json");
+  const launcher = join(root, "bin", "codex-pool-launcher");
+  const ready = atomicWrite(launcher, POOL_LAUNCHER_SOURCE, 0o700);
+  const quotas = new PoolQuotaReader();
+  let coordinator: PoolCoordinator | undefined;
+  let disposed = false;
+  let activating: Promise<void> | undefined;
+  let reopenTimer: ReturnType<typeof setInterval> | undefined;
+  let draining = false;
+  const stopWake = wakePool(root);
+
+  const attach = (paseo: PaseoApi) => {
+    if (disposed) return;
+    if (activating) return;
+    activating = (async () => {
+      const inspect: PoolPorts["inspect"] = async (id) => {
+        const value = await paseo.agents.ref(id).refresh();
+        if (!value) return null;
+        const agent = value.agent;
+        return {
+          id,
+          provider: agent.provider,
+          model: agent.runtimeInfo?.model ?? agent.model ?? null,
+          threadId: agent.persistence?.nativeHandle ?? agent.persistence?.sessionId ?? null,
+          busy:
+            agent.status === "running" ||
+            agent.status === "initializing" ||
+            !!agent.activeTurn ||
+            agent.pendingPermissions.length > 0,
+          archived: !!agent.archivedAt,
+          lastUserMessageAt: agent.lastUserMessageAt,
+        } satisfies PoolAgent;
+      };
+      let supportsReload: Promise<boolean> | undefined;
+      coordinator = new PoolCoordinator(root, {
+        supportsIdleReload: () => {
+          supportsReload ??= hostRpc(root, null, { timeoutMs: 10_000 })
+            .then((info) => object(info.features).agentReloadIfIdle === true)
+            .catch((error) => {
+              supportsReload = undefined;
+              throw error;
+            });
+          return supportsReload;
+        },
+        reloadIfIdle: async (id, requestId) => {
+          const result = await hostRpc(
+            root,
+            { type: "agent.session.reload_if_idle.request", agentId: id, requestId },
+            { requiredFeature: "agentReloadIfIdle" },
+          );
+          if (result.outcome === "busy") return "busy";
+          if (result.outcome !== "reloaded") throw new Error("Invalid idle reload response");
+          const commands = await paseo.agents.ref(id).commands();
+          if (commands.error) throw new Error("Selected account failed to initialize");
+          return "reloaded";
+        },
+        accounts: (includeDisabled) => readPoolAccounts(configPath, includeDisabled),
+        enabled: async () => (await readRegistry(root)).autoFailover.codex,
+        inspect,
+        probe: (account, model) => quotas.read(account, model),
+        now: Date.now,
+        reload: async (id, guard) => {
+          try {
+            await hostRpc(root, { type: "refresh_agent_request", agentId: id }, { guard });
+          } catch (error) {
+            if (error instanceof HostRpcIndeterminateError)
+              throw new PoolReloadPendingError("Reload acknowledgement was lost");
+            throw error;
+          }
+          const result = await paseo.agents.ref(id).commands();
+          if (result.error) throw new Error("Target session did not initialize");
+        },
+        confirm: async (id, route) => {
+          // Receipt follows successful thread/resume, never just process spawn.
+          for (let attempt = 0; attempt < 20; attempt++) {
+            const receipt = await readState(poolPath(root, "receipts", id), LaunchReceiptSchema);
+            if (
+              receipt?.token === route.token &&
+              receipt.accountId === route.accountId &&
+              receipt.threadId === route.threadId
+            )
+              return true;
+            await new Promise((resolve) => setTimeout(resolve, 100));
+          }
+          return false;
+        },
+        stop: async (id, messageId) => {
+          const ownsLastPrompt = async () => {
+            const page = await paseo.agents.ref(id).timeline.refetch({ limit: 200 });
+            const last = page.entries
+              .map((entry) => object(entry.item))
+              .findLast((item) => item.type === "user_message");
+            return last?.clientMessageId === messageId || last?.messageId === messageId;
+          };
+          if (await ownsLastPrompt())
+            await hostRpc(
+              root,
+              { type: "cancel_agent_request", agentId: id },
+              { guard: ownsLastPrompt },
+            );
+        },
+        send: (id, messageId) =>
+          paseo.agents.ref(id).send(CONTINUE, { messageId, activeTurnBehavior: "steer" }),
+        sent: async (id, messageId) => {
+          const page = await paseo.agents.ref(id).timeline.refetch({ limit: 200 });
+          return page.entries.some((entry) => {
+            const item = object(entry.item);
+            return (
+              item.type === "user_message" &&
+              (item.clientMessageId === messageId || item.messageId === messageId)
+            );
+          });
+        },
+        note: async (id, recovery, state, target, error) =>
+          appendFailoverRow(paseo, id, {
+            rowId: "account-failover-" + id + "-pool-" + recovery.turnKey,
+            state: state === "paused" || state === "checking" ? "waiting" : state,
+            checking: state === "checking",
+            paused: state === "paused",
+            from: recovery.sourceId,
+            fromId: recovery.sourceId,
+            to: target?.label ?? null,
+            toId: target?.id ?? null,
+            resetsAt: null,
+            waitsUntil: state === "waiting" ? new Date(recovery.retryAt).toISOString() : null,
+            waitingForEligibility: true,
+            fromUnavailable: recovery.cause === "account-unavailable",
+            error: error ?? null,
+          }),
+      });
+      // Pause can use the coordinator while startup scans older agents.
+      await ready;
+      await coordinator.restore();
+      const drain = () => {
+        if (disposed || draining || !coordinator) return;
+        draining = true;
+        for (const id of coordinator.manual.active)
+          void coordinator
+            .runManual(id)
+            .catch(() => console.error("Could not check a queued account switch"));
+        void drainReopenRequests(root, coordinator, inspect).finally(() => {
+          draining = false;
+        });
+      };
+      reopenTimer = setInterval(drain, 5_000);
+      reopenTimer.unref?.();
+      drain();
+      // Existing failed tabs are eligible too; successful/idle tabs with historical errors are left alone.
+      const ids = new Set((await readPoolAccounts(configPath)).map((account) => account.id));
+      if (!ids.size) return;
+      let cursor: string | undefined;
+      do {
+        if (disposed) return;
+        const page = await paseo.agents.list({
+          page: { limit: 200, ...(cursor ? { cursor } : {}) },
+        });
+        for (const { agent } of page.entries) {
+          if (
+            ids.has(agent.provider) &&
+            agent.status === "error" &&
+            agent.lastError &&
+            isQuotaFailure(agent.lastError)
+          ) {
+            void coordinator
+              .failed(agent.id, "existing-" + agent.updatedAt, agent.lastError)
+              .catch(() => console.error("Codex pool could not recover an existing failed turn"));
+          }
+        }
+        cursor = page.pageInfo.hasMore ? (page.pageInfo.nextCursor ?? undefined) : undefined;
+      } while (cursor);
+    })().catch(() => {
+      activating = undefined;
+      console.error("Codex pool initialization failed");
+    });
+  };
+
+  const removers = [
+    server.on("agent.turn_ended", (event, { paseo }) => {
+      attach(paseo);
+      void activating
+        ?.then(async () => {
+          if (event.outcome.kind === "failed") {
+            const route = await readState(poolPath(root, "routes", event.agent.id), RouteSchema);
+            const missing =
+              route &&
+              !(await readPoolAccounts(configPath)).some(
+                (account) => account.id === route.accountId && account.pool === route.pool,
+              );
+            return coordinator?.failed(
+              event.agent.id,
+              event.turnId ?? "failed-" + Date.now(),
+              missing ? "codex-pool.account-unavailable" : event.outcome.error.message,
+            );
+          }
+          await coordinator?.cancel(event.agent.id);
+          return coordinator?.runManual(event.agent.id);
+        })
+        .catch(() => console.error("Codex pool recovery failed; pending recovery is retained"));
+    }),
+    server.on("agent.turn_started", ({ agent }, { paseo }) => {
+      attach(paseo);
+      coordinator?.started(agent.id);
+    }),
+    server.on("agent.archived", ({ agent }) => {
+      void coordinator?.cancel(agent.id);
+    }),
+    server.on("agent.permission_requested", ({ agent }) => {
+      void coordinator?.cancel(agent.id);
+    }),
+    server.before("agent.session_open", async ({ request }, { paseo }) => {
+      attach(paseo);
+      const path = poolPath(root, "bindings", request.agentId);
+      if (!(await readState(path, PoolBindingSchema))) {
+        const source = (await readPoolAccounts(configPath, true)).find(
+          (account) => account.id === request.provider,
+        );
+        if (source)
+          await writeState(path, {
+            originId: request.provider,
+            accountId: source.id,
+            pool: source.pool,
+            location: { home: source.home, ...(source.ssh ? { ssh: source.ssh } : {}) },
+          });
+      }
+      const correlation = (request as typeof request & { reloadRequestId?: string })
+        .reloadRequestId;
+      if (request.reason === "refresh" && request.purpose === "interactive" && correlation) {
+        const proposal = await readState(
+          poolPath(root, "manual", request.agentId),
+          ManualRequestSchema,
+        );
+        if (
+          proposal?.phase === "switching" &&
+          proposal.token === correlation &&
+          proposal.originId === request.provider
+        )
+          return { ...request, env: { ...request.env, [MANUAL_TOKEN_ENV]: correlation } };
+      }
+      return request;
+    }),
+  ];
+  server.handle(
+    defineRpc({ name: "codex-pool.start", input: z.object({}), output: z.object({}) }),
+    (_input, { paseo }) => {
+      attach(paseo);
+      return {};
+    },
+  );
+  const pool = (paseo: PaseoApi) => {
+    attach(paseo);
+    if (!coordinator) throw new Error("Codex pool is unavailable");
+    return coordinator;
+  };
+  server.handle(readModelAccount, ({ agentId }, { paseo }) => pool(paseo).manual.read(agentId));
+  server.handle(selectModelAccount, async ({ agentId, accountId }, { paseo }) => {
+    const owner = pool(paseo);
+    await owner.manual.select(agentId, accountId);
+    void owner
+      .runManual(agentId)
+      .catch(() => console.error("Could not apply a queued account switch"));
+    return {};
+  });
+  server.handle(cancelModelAccount, async ({ agentId }, { paseo }) => {
+    await pool(paseo).manual.cancel(agentId);
+    return {};
+  });
+  server.handle(pausePoolRecovery, async ({ agentId, rowId }, { paseo }) => {
+    attach(paseo);
+    if (!coordinator) throw new Error("Codex pool is unavailable");
+    return { paused: await coordinator.pause(agentId, rowId) };
+  });
+  return {
+    attach,
+    async close() {
+      disposed = true;
+      if (reopenTimer) clearInterval(reopenTimer);
+      stopWake();
+      for (const remove of removers) remove();
+      await activating;
+      await coordinator?.close();
+    },
+  };
+}
